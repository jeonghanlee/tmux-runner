#!/usr/bin/env bash

set -euo pipefail

readonly PROGRAM_NAME="${0##*/}"
readonly RUNNER_VERSION="0.1.0"
readonly RUNNER_GIT_HASH="unknown"
readonly RUNNER_COMMIT_DATE="unreleased"
readonly RUNNER_INSTALL_DATE="unreleased"
readonly TMUX_SERVER_NAME="tmux-runner"
TMUX_BIN=$(type -P tmux || true)
readonly TMUX_BIN
HOSTNAME_BIN=$(type -P hostname || true)
readonly HOSTNAME_BIN
GIT_BIN=$(type -P git || true)
readonly GIT_BIN
SHA256_BIN=$(type -P sha256sum || true)
readonly SHA256_BIN
FIND_BIN=$(type -P find || true)
readonly FIND_BIN
SORT_BIN=$(type -P sort || true)
readonly SORT_BIN
MANAGED_SESSION_NAMES=()
MANAGED_SESSION_PATHS=()
PATH_MATCHES=()
REPOSITORY_ROOTS=()
CATALOG_PATHS=()
CATALOG_LABELS=()
CATALOG_DEPTHS=()
CATALOG_DUPLICATES=()

function print_usage {
    printf 'Usage:\n'
    printf '  %s create [-s <session-name>] [-c <folder>]\n' "$PROGRAM_NAME"
    printf '  %s c [-s <session-name>] [-c <folder>]\n' "$PROGRAM_NAME"
    printf '  %s repo\n' "$PROGRAM_NAME"
    printf '  %s ls\n' "$PROGRAM_NAME"
    printf '  %s attach -t <session-name>\n' "$PROGRAM_NAME"
    printf '  %s attach <session-name>\n' "$PROGRAM_NAME"
    printf '  %s attach -- <session-name>\n' "$PROGRAM_NAME"
    printf '  %s a -t <session-name>\n' "$PROGRAM_NAME"
    printf '  %s a <session-name>\n' "$PROGRAM_NAME"
    printf '  %s a -- <session-name>\n' "$PROGRAM_NAME"
    printf '\nCommands:\n'
    printf '  create, c  Create or reuse a session and enter it.\n'
    printf '  repo       Discover repositories, select one, and enter it.\n'
    printf '  ls         List sessions, select one by number, and enter it.\n'
    printf '  attach, a  Enter an existing session by name.\n'
    printf '\nOptions:\n'
    printf '  -V, --version  Show version and Git metadata.\n'
    printf '  -h, --help     Show this help and exit.\n'
    printf '\nServer:\n'
    printf '  Session commands use the dedicated tmux -L tmux-runner server.\n'
    # The help text documents the shell fallback expression literally.
    # shellcheck disable=SC2016
    printf '  Config: ${XDG_CONFIG_HOME:-$HOME/.config}/tmux-runner/tmux.conf\n'
    printf '  Detach before running a session command from another tmux server.\n'
}

function print_version {
    local display_hash="$RUNNER_GIT_HASH"
    local display_commit_date="$RUNNER_COMMIT_DATE"
    local display_install_date="$RUNNER_INSTALL_DATE"
    local script_source="${BASH_SOURCE[0]}"
    local script_directory=""
    local git_bin=""
    local date_bin=""
    local commit_timestamp=""

    if [[ "$display_hash" == "unknown" ]]; then
        git_bin=$(type -P git || true)
        date_bin=$(type -P date || true)
        if [[ "$script_source" == */* ]]; then
            script_directory="${script_source%/*}"
        else
            script_directory="."
        fi
        if script_directory=$(cd -- "$script_directory" 2>/dev/null && pwd -P) && \
            [[ -n "$git_bin" ]] && [[ -x "$git_bin" ]] && \
            "$git_bin" -C "$script_directory" rev-parse \
                --is-inside-work-tree >/dev/null 2>&1; then
            display_hash=$(
                "$git_bin" -C "$script_directory" rev-parse --short HEAD
            )
            if ! "$git_bin" -C "$script_directory" diff --quiet HEAD -- \
                2>/dev/null; then
                display_hash="${display_hash}-dirty"
            fi
            display_hash="${display_hash} (live)"
            commit_timestamp=$(
                "$git_bin" -C "$script_directory" show -s --format=%ct HEAD \
                    2>/dev/null || true
            )
            if [[ -n "$commit_timestamp" ]] && [[ -n "$date_bin" ]] && \
                [[ -x "$date_bin" ]]; then
                if ! display_commit_date=$(
                    "$date_bin" -u -d "@${commit_timestamp}" \
                        '+%Y-%m-%dT%H:%M:%SZ'
                ); then
                    display_commit_date="unknown"
                fi
            else
                display_commit_date="unknown"
            fi
            display_install_date="live"
        fi
    fi

    printf '%s version %s (%s)\n' \
        "$PROGRAM_NAME" "$RUNNER_VERSION" "$display_hash"
    printf 'commit date:  %s\n' "$display_commit_date"
    printf 'install date: %s\n' "$display_install_date"
}

function print_create_usage {
    local command_name="$1"

    printf 'Usage: %s %s [-s <session-name>] [-c <folder>]\n' \
        "$PROGRAM_NAME" "$command_name"
}

function print_create_help {
    local command_name="$1"

    print_create_usage "$command_name"
    printf '\nCreate or reuse a session and enter it immediately.\n'
    printf '\nOptions:\n'
    printf '  -s <session-name>  Set the session name.\n'
    printf '  -c <folder>        Set the session working directory.\n'
    printf '  -h, --help         Show this help and exit.\n'
    printf '\nDefaults:\n'
    printf '  Folder: current directory\n'
    printf '  Working directory: Git top level, or the resolved folder outside Git\n'
    printf '  First session name: <repo-or-folder>-<short-hostname>\n'
    printf '\nIdentity:\n'
    printf '  Automatic names reuse one exact @tmux-runner-path match, including\n'
    printf '  an explicit name; multiple matches fail and list their names.\n'
    printf '  Name collisions add minimum parent components, then a path hash.\n'
    printf '  Explicit -s names fail if occupied by another or unmarked path.\n'
}

function print_list_help {
    printf 'Usage: %s ls\n' "$PROGRAM_NAME"
    printf '\nList complete tmux session rows, select one by number, and enter it.\n'
    printf '\nOptions:\n'
    printf '  -h, --help  Show this help and exit.\n'
}

function print_repo_help {
    printf 'Usage: %s repo\n' "$PROGRAM_NAME"
    printf '\nDiscover configured Git working trees, select one by number, and enter it.\n'
    printf '\nOptions:\n'
    printf '  -h, --help  Show this help and exit.\n'
    printf '\nConfiguration:\n'
    # The help text documents the shell fallback expression literally.
    # shellcheck disable=SC2016
    printf '  ${XDG_CONFIG_HOME:-$HOME/.config}/tmux-runner/repos\n'
    printf '  Add one literal absolute search root per line.\n'
}

function print_attach_usage {
    local command_name="$1"

    printf 'Usage: %s %s -t <session-name>\n' \
        "$PROGRAM_NAME" "$command_name"
    printf '       %s %s <session-name>\n' \
        "$PROGRAM_NAME" "$command_name"
    printf '       %s %s -- <session-name>\n' \
        "$PROGRAM_NAME" "$command_name"
}

function print_attach_help {
    local command_name="$1"

    print_attach_usage "$command_name"
    printf '\nEnter an existing session by exact name.\n'
    printf '\nOptions:\n'
    printf '  -t <session-name>  Set the target session.\n'
    printf '  -h, --help         Show this help and exit.\n'
    printf '\nUse -- before a positional session name that begins with -.\n'
}

function fail {
    local message="$1"

    printf '%s: %s\n' "$PROGRAM_NAME" "$message" >&2
    return 2
}

function fail_create_usage {
    local command_name="$1"
    local message="$2"

    printf '%s: %s\n' "$PROGRAM_NAME" "$message" >&2
    print_create_usage "$command_name" >&2
    return 2
}

function fail_attach_usage {
    local command_name="$1"
    local message="$2"

    printf '%s: %s\n' "$PROGRAM_NAME" "$message" >&2
    print_attach_usage "$command_name" >&2
    return 2
}

function normalize_session_name {
    local session_name="$1"

    session_name="${session_name//./_}"
    session_name="${session_name//:/_}"
    printf '%s\n' "$session_name"
}

function resolve_working_path {
    local directory="$1"
    local git_top=""
    local resolved_top=""

    if [[ -z "$GIT_BIN" ]] || [[ ! -x "$GIT_BIN" ]]; then
        fail "git is not available in PATH"
        return
    fi
    if git_top=$("$GIT_BIN" -C "$directory" rev-parse --show-toplevel \
        2>/dev/null); then
        if ! resolved_top=$(cd -- "$git_top" 2>/dev/null && pwd -P); then
            fail "Git top level is not accessible: $git_top"
            return
        fi
        printf '%s\n' "$resolved_top"
    else
        printf '%s\n' "$directory"
    fi
}

function load_managed_sessions {
    local session_name=""
    local session_path=""
    local -a session_names=()

    MANAGED_SESSION_NAMES=()
    MANAGED_SESSION_PATHS=()
    mapfile -t session_names < <(
        run_tmux_command list-sessions -F '#{session_name}' 2>/dev/null || true
    )
    for session_name in "${session_names[@]}"; do
        session_path=$(run_tmux_command show-options -qv \
            -t "=$session_name:" @tmux-runner-path 2>/dev/null || true)
        if [[ -n "$session_path" ]]; then
            MANAGED_SESSION_NAMES+=("$session_name")
            MANAGED_SESSION_PATHS+=("$session_path")
        fi
    done
}

function find_path_matches {
    local canonical_path="$1"
    local index=0

    PATH_MATCHES=()
    for index in "${!MANAGED_SESSION_PATHS[@]}"; do
        if [[ "${MANAGED_SESSION_PATHS[$index]}" == "$canonical_path" ]]; then
            PATH_MATCHES+=("${MANAGED_SESSION_NAMES[$index]}")
        fi
    done
}

function report_ambiguous_path {
    local canonical_path="$1"
    local session_name=""

    printf '%s: multiple sessions match path: %s\n' \
        "$PROGRAM_NAME" "$canonical_path" >&2
    for session_name in "${PATH_MATCHES[@]}"; do
        printf '  %s\n' "$session_name" >&2
    done
    return 2
}

function session_path_option {
    local session_name="$1"

    run_tmux_command show-options -qv -t "=$session_name:" \
        @tmux-runner-path 2>/dev/null || true
}

function connect_verified_path {
    local session_name="$1"
    local canonical_path="$2"
    local current_path=""

    current_path=$(session_path_option "$session_name")
    if [[ "$current_path" != "$canonical_path" ]]; then
        fail "session identity changed before attachment: $session_name"
        return
    fi
    connect_session "$session_name"
}

function try_marked_session {
    local session_name="$1"
    local canonical_path="$2"
    local target="=$session_name"
    local existing_path=""
    local create_output=""
    local create_rc=0

    if run_tmux_command has-session -t "$target" 2>/dev/null; then
        existing_path=$(session_path_option "$session_name")
        if [[ "$existing_path" == "$canonical_path" ]]; then
            return 0
        fi
        return 3
    fi

    # set-option takes a pane target. The trailing colon keeps the session
    # component exact while selecting its current window.
    create_output=$(run_tmux_command new-session -d -s "$session_name" \
        -c "$canonical_path" \; set-option -t "=$session_name:" \
        @tmux-runner-path "$canonical_path" 2>&1) || create_rc=$?
    if (( create_rc == 0 )); then
        return 0
    fi
    if run_tmux_command has-session -t "$target" 2>/dev/null; then
        existing_path=$(session_path_option "$session_name")
        if [[ "$existing_path" == "$canonical_path" ]]; then
            return 0
        fi
        return 3
    fi
    if [[ -n "$create_output" ]]; then
        printf '%s\n' "$create_output" >&2
    fi
    return "$create_rc"
}

function report_explicit_conflict {
    local session_name="$1"
    local canonical_path="$2"
    local existing_path=""

    existing_path=$(session_path_option "$session_name")
    if [[ -z "$existing_path" ]]; then
        fail "session $session_name exists without @tmux-runner-path; choose another -s name or attach directly"
    else
        fail "session $session_name belongs to $existing_path, not $canonical_path"
    fi
}

function path_parent_count {
    local canonical_path="$1"
    local parent_path=""
    local -a components=()

    if [[ "$canonical_path" == "/" ]]; then
        printf '0\n'
        return 0
    fi
    parent_path="${canonical_path%/*}"
    parent_path="${parent_path#/}"
    if [[ -z "$parent_path" ]]; then
        printf '0\n'
        return 0
    fi
    IFS='/' read -r -a components <<< "$parent_path"
    printf '%d\n' "${#components[@]}"
}

function path_stem_at_depth {
    local canonical_path="$1"
    local depth="$2"
    local base_name="${canonical_path##*/}"
    local parent_path=""
    local prefix=""
    local component=""
    local start=0
    local index=0
    local -a components=()

    if [[ -z "$base_name" ]]; then
        base_name="root"
    fi
    parent_path="${canonical_path%/*}"
    parent_path="${parent_path#/}"
    if [[ -n "$parent_path" ]]; then
        IFS='/' read -r -a components <<< "$parent_path"
    fi
    start=$((${#components[@]} - depth))
    if (( start < 0 )); then
        start=0
    fi
    for ((index = start; index < ${#components[@]}; index++)); do
        component="${components[$index]}"
        if [[ -n "$prefix" ]]; then
            prefix="${prefix}-${component}"
        else
            prefix="$component"
        fi
    done
    if [[ -n "$prefix" ]]; then
        printf '%s-%s\n' "$prefix" "$base_name"
    else
        printf '%s\n' "$base_name"
    fi
}

function normalized_base_name {
    local canonical_path="$1"
    local base_name="${canonical_path##*/}"

    if [[ -z "$base_name" ]]; then
        base_name="root"
    fi
    normalize_session_name "$base_name"
}

function candidate_distinguishes_path {
    local canonical_path="$1"
    local depth="$2"
    local current_base=""
    local current_stem=""
    local other_base=""
    local other_stem=""
    local other_path=""

    current_base=$(normalized_base_name "$canonical_path")
    current_stem=$(path_stem_at_depth "$canonical_path" "$depth")
    current_stem=$(normalize_session_name "$current_stem")
    for other_path in "${MANAGED_SESSION_PATHS[@]}"; do
        if [[ "$other_path" == "$canonical_path" ]]; then
            continue
        fi
        other_base=$(normalized_base_name "$other_path")
        if [[ "$other_base" != "$current_base" ]]; then
            continue
        fi
        other_stem=$(path_stem_at_depth "$other_path" "$depth")
        other_stem=$(normalize_session_name "$other_stem")
        if [[ "$other_stem" == "$current_stem" ]]; then
            return 1
        fi
    done
    return 0
}

function max_collision_depth {
    local canonical_path="$1"
    local current_base=""
    local other_base=""
    local other_depth=0
    local maximum=0
    local other_path=""

    current_base=$(normalized_base_name "$canonical_path")
    maximum=$(path_parent_count "$canonical_path")
    for other_path in "${MANAGED_SESSION_PATHS[@]}"; do
        other_base=$(normalized_base_name "$other_path")
        if [[ "$other_base" != "$current_base" ]]; then
            continue
        fi
        other_depth=$(path_parent_count "$other_path")
        if (( other_depth > maximum )); then
            maximum=$other_depth
        fi
    done
    printf '%d\n' "$maximum"
}

function has_same_base_collision {
    local canonical_path="$1"
    local current_base=""
    local other_base=""
    local other_path=""

    current_base=$(normalized_base_name "$canonical_path")
    for other_path in "${MANAGED_SESSION_PATHS[@]}"; do
        if [[ "$other_path" == "$canonical_path" ]]; then
            continue
        fi
        other_base=$(normalized_base_name "$other_path")
        if [[ "$other_base" == "$current_base" ]]; then
            return 0
        fi
    done
    return 1
}

function runner_repos_file {
    local config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"

    printf '%s/tmux-runner/repos\n' "$config_home"
}

function report_repos_setup_error {
    local message="$1"
    local repos_file="$2"

    fail "$message: $repos_file"
    printf 'Add one literal absolute search root per line.\n' >&2
    return 2
}

function warn_repository_root {
    local message="$1"
    local root_path="$2"

    printf '%s: warning: %s: %s\n' \
        "$PROGRAM_NAME" "$message" "$root_path" >&2
}

function load_repository_roots {
    local required="$1"
    local repos_file=""
    local line=""
    local canonical_root=""
    local -A seen_roots=()

    REPOSITORY_ROOTS=()
    repos_file=$(runner_repos_file)
    if [[ ! -e "$repos_file" ]]; then
        if (( required )); then
            report_repos_setup_error "repository root file is missing" \
                "$repos_file"
            return
        fi
        return 1
    fi
    if [[ ! -f "$repos_file" ]] || [[ ! -r "$repos_file" ]]; then
        report_repos_setup_error "repository root file is not readable" \
            "$repos_file"
        return
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        if [[ "$line" =~ ^[[:space:]]*$ ]] || \
            [[ "$line" =~ ^[[:space:]]*# ]]; then
            continue
        fi
        if [[ "$line" != /* ]]; then
            warn_repository_root "repository root is not absolute" "$line"
            continue
        fi
        if [[ ! -d "$line" ]]; then
            warn_repository_root "repository root is missing" "$line"
            continue
        fi
        if [[ ! -r "$line" ]] || [[ ! -x "$line" ]]; then
            warn_repository_root "repository root is not accessible" "$line"
            continue
        fi
        if ! canonical_root=$(cd -- "$line" 2>/dev/null && pwd -P); then
            warn_repository_root "repository root is not accessible" "$line"
            continue
        fi
        if [[ -z "${seen_roots[$canonical_root]+present}" ]]; then
            seen_roots["$canonical_root"]=1
            REPOSITORY_ROOTS+=("$canonical_root")
        fi
    done < "$repos_file"

    if (( ${#REPOSITORY_ROOTS[@]} == 0 )); then
        if (( required )); then
            report_repos_setup_error "repository root file has no usable roots" \
                "$repos_file"
            return
        fi
        return 1
    fi
}

function is_git_worktree_path {
    local candidate_path="$1"
    local inside_work_tree=""
    local bare_repository=""
    local git_top=""
    local physical_top=""

    inside_work_tree=$("$GIT_BIN" -C "$candidate_path" rev-parse \
        --is-inside-work-tree 2>/dev/null) || return 1
    [[ "$inside_work_tree" == "true" ]] || return 1
    bare_repository=$("$GIT_BIN" -C "$candidate_path" rev-parse \
        --is-bare-repository 2>/dev/null) || return 1
    [[ "$bare_repository" == "false" ]] || return 1
    git_top=$("$GIT_BIN" -C "$candidate_path" rev-parse --show-toplevel \
        2>/dev/null) || return 1
    physical_top=$(cd -- "$git_top" 2>/dev/null && pwd -P) || return 1
    [[ "$physical_top" == "$candidate_path" ]]
}

function discover_repository_catalog {
    local required="$1"
    local repos_file=""
    local root_path=""
    local marker_path=""
    local candidate_path=""
    local -a markers=()
    local -A seen_paths=()

    CATALOG_PATHS=()
    for root_path in "${REPOSITORY_ROOTS[@]}"; do
        markers=()
        while IFS= read -r -d '' marker_path; do
            markers+=("$marker_path")
        done < <(
            "$FIND_BIN" -P "$root_path" \
                \( -type d -name .git -print0 -prune \) -o \
                \( -type f -name .git -print0 \)
        )
        for marker_path in "${markers[@]}"; do
            candidate_path="${marker_path%/.git}"
            if ! candidate_path=$(cd -- "$candidate_path" 2>/dev/null && \
                pwd -P); then
                continue
            fi
            if is_git_worktree_path "$candidate_path" && \
                [[ -z "${seen_paths[$candidate_path]+present}" ]]; then
                seen_paths["$candidate_path"]=1
                CATALOG_PATHS+=("$candidate_path")
            fi
        done
    done

    if (( ${#CATALOG_PATHS[@]} > 0 )); then
        mapfile -t CATALOG_PATHS < <(
            printf '%s\n' "${CATALOG_PATHS[@]}" | \
                LC_ALL=C "$SORT_BIN" -u
        )
        return 0
    fi
    if (( required )); then
        repos_file=$(runner_repos_file)
        fail "no Git working trees found under roots in: $repos_file"
        return
    fi
    return 1
}

function catalog_labels_have_duplicate {
    local first_index=0
    local second_index=0

    CATALOG_DUPLICATES=()
    for first_index in "${!CATALOG_PATHS[@]}"; do
        CATALOG_DUPLICATES+=(0)
    done
    for first_index in "${!CATALOG_LABELS[@]}"; do
        for ((second_index = first_index + 1; \
            second_index < ${#CATALOG_LABELS[@]}; second_index++)); do
            if [[ "${CATALOG_LABELS[$first_index]}" == \
                "${CATALOG_LABELS[$second_index]}" ]]; then
                CATALOG_DUPLICATES[first_index]=1
                CATALOG_DUPLICATES[second_index]=1
            fi
        done
    done
    for first_index in "${!CATALOG_DUPLICATES[@]}"; do
        if (( CATALOG_DUPLICATES[first_index] )); then
            return 0
        fi
    done
    return 1
}

function catalog_label_is_used {
    local candidate_label="$1"
    local current_index="$2"
    local index=0

    for index in "${!CATALOG_LABELS[@]}"; do
        if (( index == current_index )); then
            continue
        fi
        if [[ "${CATALOG_LABELS[$index]}" == "$candidate_label" ]]; then
            return 0
        fi
    done
    return 1
}

function build_catalog_labels {
    local index=0
    local parent_count=0
    local made_progress=0
    local stem=""
    local hash_output=""
    local path_hash=""
    local candidate_label=""
    local hash_length=12

    CATALOG_LABELS=()
    CATALOG_DEPTHS=()
    for index in "${!CATALOG_PATHS[@]}"; do
        CATALOG_LABELS+=("")
        CATALOG_DEPTHS+=(0)
    done

    while true; do
        for index in "${!CATALOG_PATHS[@]}"; do
            stem=$(path_stem_at_depth "${CATALOG_PATHS[$index]}" \
                "${CATALOG_DEPTHS[$index]}")
            CATALOG_LABELS[index]=$(normalize_session_name "$stem")
        done
        if ! catalog_labels_have_duplicate; then
            return 0
        fi
        made_progress=0
        for index in "${!CATALOG_PATHS[@]}"; do
            if (( ! CATALOG_DUPLICATES[index] )); then
                continue
            fi
            parent_count=$(path_parent_count "${CATALOG_PATHS[$index]}")
            if (( CATALOG_DEPTHS[index] < parent_count )); then
                CATALOG_DEPTHS[index]=$((CATALOG_DEPTHS[index] + 1))
                made_progress=1
            fi
        done
        if (( ! made_progress )); then
            break
        fi
    done

    if [[ -z "$SHA256_BIN" ]] || [[ ! -x "$SHA256_BIN" ]]; then
        fail "sha256sum is required to resolve repository-label collisions"
        return
    fi
    for index in "${!CATALOG_PATHS[@]}"; do
        if (( ! CATALOG_DUPLICATES[index] )); then
            continue
        fi
        hash_output=$(printf '%s' "${CATALOG_PATHS[$index]}" | \
            "$SHA256_BIN")
        path_hash="${hash_output%% *}"
        for ((hash_length = 12; hash_length <= 64; hash_length++)); do
            candidate_label="${CATALOG_LABELS[$index]}-${path_hash:0:hash_length}"
            if ! catalog_label_is_used "$candidate_label" "$index"; then
                CATALOG_LABELS[index]="$candidate_label"
                break
            fi
        done
        if catalog_label_is_used "${CATALOG_LABELS[$index]}" "$index"; then
            fail "no unique repository label is available for path: ${CATALOG_PATHS[$index]}"
            return
        fi
    done
}

function load_repository_catalog {
    local required="$1"
    local load_rc=0

    load_repository_roots "$required" || load_rc=$?
    if (( load_rc != 0 )); then
        return "$load_rc"
    fi
    if [[ -z "$GIT_BIN" ]] || [[ ! -x "$GIT_BIN" ]]; then
        fail "git is not available in PATH"
        return
    fi
    if [[ -z "$FIND_BIN" ]] || [[ ! -x "$FIND_BIN" ]]; then
        fail "find is not available in PATH"
        return
    fi
    if [[ -z "$SORT_BIN" ]] || [[ ! -x "$SORT_BIN" ]]; then
        fail "sort is not available in PATH"
        return
    fi
    discover_repository_catalog "$required" || load_rc=$?
    if (( load_rc != 0 )); then
        return "$load_rc"
    fi
    build_catalog_labels
}

function catalog_label_for_path {
    local canonical_path="$1"
    local index=0

    for index in "${!CATALOG_PATHS[@]}"; do
        if [[ "${CATALOG_PATHS[$index]}" == "$canonical_path" ]]; then
            printf '%s\n' "${CATALOG_LABELS[$index]}"
            return 0
        fi
    done
    return 1
}

function connect_auto_path {
    local canonical_path="$1"
    local candidate_name="$2"
    local candidate_path=""

    load_managed_sessions
    find_path_matches "$canonical_path"
    if (( ${#PATH_MATCHES[@]} > 1 )); then
        report_ambiguous_path "$canonical_path"
        return
    fi
    if (( ${#PATH_MATCHES[@]} == 1 )); then
        connect_verified_path "${PATH_MATCHES[0]}" "$canonical_path"
    else
        candidate_path=$(session_path_option "$candidate_name")
        if [[ "$candidate_path" != "$canonical_path" ]]; then
            fail "session identity changed before attachment: $candidate_name"
            return
        fi
        connect_session "$candidate_name"
    fi
}

function enter_explicit_path {
    local session_name="$1"
    local canonical_path="$2"
    local attempt_rc=0

    try_marked_session "$session_name" "$canonical_path" || attempt_rc=$?
    if (( attempt_rc == 0 )); then
        connect_verified_path "$session_name" "$canonical_path"
        return
    fi
    if (( attempt_rc == 3 )); then
        report_explicit_conflict "$session_name" "$canonical_path"
        return
    fi
    return "$attempt_rc"
}

function enter_automatic_path {
    local canonical_path="$1"
    local short_hostname="$2"
    local stem=""
    local candidate_name=""
    local previous_candidate=""
    local hash_output=""
    local path_hash=""
    local depth=0
    local start_depth=0
    local maximum_depth=0
    local hash_length=12
    local attempt_rc=0

    load_managed_sessions
    find_path_matches "$canonical_path"
    if (( ${#PATH_MATCHES[@]} > 1 )); then
        report_ambiguous_path "$canonical_path"
        return
    fi
    if (( ${#PATH_MATCHES[@]} == 1 )); then
        connect_verified_path "${PATH_MATCHES[0]}" "$canonical_path"
        return
    fi

    if has_same_base_collision "$canonical_path"; then
        start_depth=1
    fi
    maximum_depth=$(max_collision_depth "$canonical_path")
    for ((depth = start_depth; depth <= maximum_depth; depth++)); do
        if ! candidate_distinguishes_path "$canonical_path" "$depth"; then
            continue
        fi
        stem=$(path_stem_at_depth "$canonical_path" "$depth")
        candidate_name=$(normalize_session_name "${stem}-${short_hostname}")
        if [[ "$candidate_name" == "$previous_candidate" ]]; then
            continue
        fi
        previous_candidate="$candidate_name"
        attempt_rc=0
        try_marked_session "$candidate_name" "$canonical_path" || \
            attempt_rc=$?
        if (( attempt_rc == 0 )); then
            connect_auto_path "$canonical_path" "$candidate_name"
            return
        fi
        if (( attempt_rc != 3 )); then
            return "$attempt_rc"
        fi
        load_managed_sessions
    done

    if [[ -z "$SHA256_BIN" ]] || [[ ! -x "$SHA256_BIN" ]]; then
        fail "sha256sum is required to resolve this session-name collision"
        return
    fi
    stem=$(path_stem_at_depth "$canonical_path" \
        "$(path_parent_count "$canonical_path")")
    hash_output=$(printf '%s' "$canonical_path" | "$SHA256_BIN")
    path_hash="${hash_output%% *}"
    for ((hash_length = 12; hash_length <= 64; hash_length++)); do
        candidate_name=$(normalize_session_name \
            "${stem}-${path_hash:0:hash_length}-${short_hostname}")
        attempt_rc=0
        try_marked_session "$candidate_name" "$canonical_path" || \
            attempt_rc=$?
        if (( attempt_rc == 0 )); then
            connect_auto_path "$canonical_path" "$candidate_name"
            return
        fi
        if (( attempt_rc != 3 )); then
            return "$attempt_rc"
        fi
    done
    fail "no unique session name is available for path: $canonical_path"
}

function enter_catalog_path {
    local canonical_path="$1"
    local catalog_label="$2"
    local short_hostname="$3"
    local candidate_name=""
    local hash_output=""
    local path_hash=""
    local hash_length=12
    local attempt_rc=0

    load_managed_sessions
    find_path_matches "$canonical_path"
    if (( ${#PATH_MATCHES[@]} > 1 )); then
        report_ambiguous_path "$canonical_path"
        return
    fi
    if (( ${#PATH_MATCHES[@]} == 1 )); then
        connect_verified_path "${PATH_MATCHES[0]}" "$canonical_path"
        return
    fi

    candidate_name=$(normalize_session_name \
        "${catalog_label}-${short_hostname}")
    try_marked_session "$candidate_name" "$canonical_path" || attempt_rc=$?
    if (( attempt_rc == 0 )); then
        connect_auto_path "$canonical_path" "$candidate_name"
        return
    fi
    if (( attempt_rc != 3 )); then
        return "$attempt_rc"
    fi

    if [[ -z "$SHA256_BIN" ]] || [[ ! -x "$SHA256_BIN" ]]; then
        fail "sha256sum is required to resolve this catalog session-name collision"
        return
    fi
    hash_output=$(printf '%s' "$canonical_path" | "$SHA256_BIN")
    path_hash="${hash_output%% *}"
    for ((hash_length = 12; hash_length <= 64; hash_length++)); do
        candidate_name=$(normalize_session_name \
            "${catalog_label}-${path_hash:0:hash_length}-${short_hostname}")
        attempt_rc=0
        try_marked_session "$candidate_name" "$canonical_path" || \
            attempt_rc=$?
        if (( attempt_rc == 0 )); then
            connect_auto_path "$canonical_path" "$candidate_name"
            return
        fi
        if (( attempt_rc != 3 )); then
            return "$attempt_rc"
        fi
    done
    fail "no unique catalog session name is available for path: $canonical_path"
}

function revalidate_catalog_path {
    local selected_path="$1"
    local physical_path=""

    if ! physical_path=$(cd -- "$selected_path" 2>/dev/null && pwd -P); then
        fail "selected repository is no longer accessible: $selected_path"
        return
    fi
    if [[ "$physical_path" != "$selected_path" ]]; then
        fail "selected repository path changed after listing: $selected_path"
        return
    fi
    if ! is_git_worktree_path "$selected_path"; then
        fail "selected path is no longer a Git working tree: $selected_path"
        return
    fi
}

function runner_config_file {
    local config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"

    printf '%s/tmux-runner/tmux.conf\n' "$config_home"
}

function runner_socket_path {
    local socket_root="${TMUX_TMPDIR:-/tmp}"

    socket_root="${socket_root%/}"
    printf '%s/tmux-%s/%s\n' "$socket_root" "$UID" "$TMUX_SERVER_NAME"
}

function validate_client_server {
    local current_socket=""
    local expected_socket=""

    if [[ -z "${TMUX:-}" ]]; then
        return 0
    fi
    current_socket="${TMUX%%,*}"
    expected_socket=$(runner_socket_path)
    if [[ "$current_socket" != "$expected_socket" ]]; then
        fail "current tmux client uses another server; detach and rerun tmux-runner from the outer shell"
        return
    fi
}

function run_tmux_command {
    local config_file=""

    config_file=$(runner_config_file)
    if [[ ! -e "$config_file" ]]; then
        config_file="/dev/null"
    fi
    "$TMUX_BIN" -L "$TMUX_SERVER_NAME" -f "$config_file" "$@"
}

function connect_session {
    local session_name="$1"
    local target="=$session_name"

    if [[ -n "${TMUX:-}" ]]; then
        run_tmux_command switch-client -t "$target"
    else
        run_tmux_command attach-session -t "$target"
    fi
}

function run_create {
    local command_name="$1"
    local session_name=""
    local directory=""
    local resolved_directory=""
    local canonical_path=""
    local catalog_label=""
    local catalog_rc=0
    local short_hostname=""
    local saw_session=0
    local saw_directory=0

    shift
    while (( $# > 0 )); do
        case "$1" in
            -s)
                if (( saw_session )) || (( $# < 2 )) || [[ -z "$2" ]]; then
                    fail_create_usage "$command_name" \
                        "-s requires one session name and may appear only once"
                    return
                fi
                session_name="$2"
                saw_session=1
                shift 2
                ;;
            -c)
                if (( saw_directory )) || (( $# < 2 )) || [[ -z "$2" ]]; then
                    fail_create_usage "$command_name" \
                        "-c requires one folder and may appear only once"
                    return
                fi
                directory="$2"
                saw_directory=1
                shift 2
                ;;
            --)
                shift
                break
                ;;
            -*)
                fail_create_usage "$command_name" "unknown option: $1"
                return
                ;;
            *)
                fail_create_usage "$command_name" "unexpected argument: $1"
                return
                ;;
        esac
    done

    if (( $# > 0 )); then
        fail_create_usage "$command_name" "unexpected argument: $1"
        return
    fi

    if [[ -z "$directory" ]]; then
        directory="$PWD"
    fi
    if ! resolved_directory=$(cd -- "$directory" 2>/dev/null && pwd -P); then
        fail_create_usage "$command_name" "folder does not exist: $directory"
        return
    fi
    canonical_path=$(resolve_working_path "$resolved_directory") || return

    if (( saw_session )); then
        session_name=$(normalize_session_name "$session_name")
        if [[ -z "$session_name" ]]; then
            fail_create_usage "$command_name" "session name must not be empty"
            return
        fi
        enter_explicit_path "$session_name" "$canonical_path"
        return
    fi

    if [[ -z "$HOSTNAME_BIN" ]] || [[ ! -x "$HOSTNAME_BIN" ]]; then
        fail "hostname is not available in PATH"
        return
    fi
    short_hostname=$("$HOSTNAME_BIN" -s)
    load_repository_catalog 0 || catalog_rc=$?
    if (( catalog_rc == 0 )) && \
        catalog_label=$(catalog_label_for_path "$canonical_path"); then
        enter_catalog_path "$canonical_path" "$catalog_label" \
            "$short_hostname"
        return
    fi
    if (( catalog_rc != 0 && catalog_rc != 1 )); then
        return "$catalog_rc"
    fi
    enter_automatic_path "$canonical_path" "$short_hostname"
}

function run_repo {
    local selection=""
    local selected_index=-1
    local selected_path=""
    local selected_label=""
    local short_hostname=""
    local index=0

    if (( $# > 0 )); then
        fail "repo does not accept arguments"
        return
    fi
    load_repository_catalog 1 || return

    for index in "${!CATALOG_PATHS[@]}"; do
        printf '%d %s  %s\n' "$((index + 1))" \
            "${CATALOG_LABELS[$index]}" "${CATALOG_PATHS[$index]}"
    done
    printf 'Select repository: '
    if ! IFS= read -r selection; then
        printf '\n' >&2
        fail "no repository selection received"
        return
    fi
    if [[ ! "$selection" =~ ^[0-9]+$ ]]; then
        fail "repository selection must be a number"
        return
    fi
    while [[ "${#selection}" -gt 1 ]] && \
        [[ "${selection:0:1}" == "0" ]]; do
        selection="${selection:1}"
    done
    for index in "${!CATALOG_PATHS[@]}"; do
        if [[ "$selection" == "$((index + 1))" ]]; then
            selected_index=$index
            break
        fi
    done
    if (( selected_index < 0 )); then
        fail "repository selection is outside the displayed range"
        return
    fi
    selected_path="${CATALOG_PATHS[$selected_index]}"
    selected_label="${CATALOG_LABELS[$selected_index]}"
    revalidate_catalog_path "$selected_path" || return
    if [[ -z "$HOSTNAME_BIN" ]] || [[ ! -x "$HOSTNAME_BIN" ]]; then
        fail "hostname is not available in PATH"
        return
    fi
    short_hostname=$("$HOSTNAME_BIN" -s)
    enter_catalog_path "$selected_path" "$selected_label" "$short_hostname"
}

function run_attach {
    local command_name="$1"
    local session_name=""
    local saw_target=0

    shift
    while (( $# > 0 )); do
        case "$1" in
            -t)
                if (( saw_target )) || [[ -n "$session_name" ]] || \
                    (( $# < 2 )) || [[ -z "$2" ]]; then
                    fail_attach_usage "$command_name" \
                        "provide exactly one session target"
                    return
                fi
                session_name="$2"
                saw_target=1
                shift 2
                ;;
            --)
                if [[ -n "$session_name" ]] || (( $# != 2 )) || \
                    [[ -z "$2" ]]; then
                    fail_attach_usage "$command_name" \
                        "provide exactly one session target"
                    return
                fi
                session_name="$2"
                saw_target=1
                shift 2
                break
                ;;
            -*)
                fail_attach_usage "$command_name" "unknown option: $1"
                return
                ;;
            *)
                if [[ -n "$session_name" ]]; then
                    fail_attach_usage "$command_name" \
                        "provide exactly one session target"
                    return
                fi
                session_name="$1"
                shift
                ;;
        esac
    done

    if (( $# > 0 )) || [[ -z "$session_name" ]]; then
        fail_attach_usage "$command_name" "provide exactly one session target"
        return
    fi

    session_name=$(normalize_session_name "$session_name")
    connect_session "$session_name"
}

function run_list {
    local output=""
    local selection=""
    local index=0
    local selected_row=""
    local selected_name=""
    local -a rows=()

    if (( $# > 0 )); then
        fail "ls does not accept arguments"
        return
    fi
    if ! output=$(run_tmux_command list-sessions); then
        return 1
    fi
    mapfile -t rows <<< "$output"

    for index in "${!rows[@]}"; do
        printf '%d %s\n' "$((index + 1))" "${rows[$index]}"
    done
    printf 'Select session: '
    if ! IFS= read -r selection; then
        printf '\n' >&2
        fail "no selection received"
        return
    fi
    if [[ ! "$selection" =~ ^[0-9]+$ ]]; then
        fail "selection must be a number"
        return
    fi

    while [[ "${#selection}" -gt 1 ]] && [[ "${selection:0:1}" == "0" ]]; do
        selection="${selection:1}"
    done
    selected_name=""
    for index in "${!rows[@]}"; do
        if [[ "$selection" == "$((index + 1))" ]]; then
            selected_row="${rows[$index]}"
            selected_name="${selected_row%%:*}"
            break
        fi
    done
    if [[ -z "$selected_name" ]]; then
        fail "selection is outside the displayed range"
        return
    fi
    connect_session "$selected_name"
}

function main {
    local command_name="${1:-}"

    if [[ -z "$command_name" ]]; then
        print_usage >&2
        return 2
    fi
    shift

    case "$command_name" in
        -V|--version)
            if (( $# > 0 )); then
                fail "version does not accept arguments"
                print_usage >&2
                return 2
            fi
            print_version
            return 0
            ;;
        -h|--help)
            if (( $# > 0 )); then
                fail "help does not accept arguments"
                print_usage >&2
                return 2
            fi
            print_usage
            return 0
            ;;
        create|c)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_create_help "$command_name"
                return 0
            fi
            ;;
        repo)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_repo_help
                return 0
            fi
            ;;
        ls)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_list_help
                return 0
            fi
            ;;
        attach|a)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_attach_help "$command_name"
                return 0
            fi
            ;;
        *)
            printf '%s: unknown command: %s\n' \
                "$PROGRAM_NAME" "$command_name" >&2
            print_usage >&2
            return 2
            ;;
    esac

    if [[ -z "$TMUX_BIN" ]] || [[ ! -x "$TMUX_BIN" ]]; then
        fail "tmux is not available in PATH"
        return
    fi
    validate_client_server || return

    case "$command_name" in
        create|c)
            run_create "$command_name" "$@"
            ;;
        repo)
            run_repo "$@"
            ;;
        attach|a)
            run_attach "$command_name" "$@"
            ;;
        ls)
            run_list "$@"
            ;;
    esac
}

main "$@"
