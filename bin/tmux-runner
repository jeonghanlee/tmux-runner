}

function fail {
    local message="$1"

    printf '%s: %s\n' "$PROGRAM_NAME" "$message" >&2
    return 2
}

function fail_create_usage {
    local command_name="$1"
    local message="$2"

    printf '%s: %s\n' "$PROGRAM_NAME" "$message" >&2
    print_create_usage "$command_name" >&2
    return 2
}

function fail_attach_usage {
    local command_name="$1"
    local message="$2"

    printf '%s: %s\n' "$PROGRAM_NAME" "$message" >&2
    print_attach_usage "$command_name" >&2
    return 2
}

function runner_state_directory {
    local state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"

    printf '%s/tmux-runner\n' "$state_home"
}

function require_state_dependencies {
    local index=0
    local -a names=(flock mktemp mkdir chmod mv ln rm sleep)
    local -a paths=(
        "$FLOCK_BIN" "$MKTEMP_BIN" "$MKDIR_BIN" "$CHMOD_BIN"
        "$MV_BIN" "$LN_BIN" "$RM_BIN" "$SLEEP_BIN"
    )

    for index in "${!names[@]}"; do
        if [[ -z "${paths[$index]}" ]] || [[ ! -x "${paths[$index]}" ]]; then
            fail "${names[$index]} is not available in PATH"
            return
        fi
    done
}

function ensure_state_directory {
    local saved_umask=""

    STATE_DIRECTORY=$(runner_state_directory)
    STATE_FILE="$STATE_DIRECTORY/state"
    if [[ -L "$STATE_DIRECTORY" ]]; then
        fail "state directory must not be a symbolic link: $STATE_DIRECTORY"
        return
    fi
    if [[ -e "$STATE_DIRECTORY" ]] && [[ ! -d "$STATE_DIRECTORY" ]]; then
        fail "state path is not a directory: $STATE_DIRECTORY"
        return
    fi

    saved_umask=$(umask)
    umask 077
    if ! "$MKDIR_BIN" -p -- "$STATE_DIRECTORY"; then
        umask "$saved_umask"
        fail "cannot create state directory: $STATE_DIRECTORY"
        return
    fi
    umask "$saved_umask"
    if [[ ! -O "$STATE_DIRECTORY" ]]; then
        fail "state directory is not owned by the current user: $STATE_DIRECTORY"
        return
    fi
    if ! "$CHMOD_BIN" 0700 -- "$STATE_DIRECTORY"; then
        fail "cannot set state directory mode: $STATE_DIRECTORY"
        return
    fi
}

function acquire_state_lock {
    if [[ -z "$STATE_LOCK_FD" ]]; then
        if ! exec {STATE_LOCK_FD}<"$STATE_DIRECTORY"; then
            fail "cannot open state directory for locking: $STATE_DIRECTORY"
            return
        fi
    fi
    if ! "$FLOCK_BIN" -x -w "$STATE_LOCK_TIMEOUT" "$STATE_LOCK_FD"; then
        fail "state lock timed out after ${STATE_LOCK_TIMEOUT} seconds"
        return
    fi
}

function release_state_lock {
    if [[ -n "$STATE_LOCK_FD" ]]; then
        "$FLOCK_BIN" -u "$STATE_LOCK_FD" 2>/dev/null || true
        exec {STATE_LOCK_FD}>&-
        STATE_LOCK_FD=""
    fi
}

function state_encode_field {
    local value="$1"

    value="${value//%/%25}"
    value="${value//$'\r'/%0D}"
    value="${value//$'\t'/%09}"
    value="${value//$'\n'/%0A}"
    STATE_ENCODED="$value"
}

function state_decode_field {
    local encoded="$1"
    local decoded=""
    local character=""

    while [[ -n "$encoded" ]]; do
        case "$encoded" in
            %25*)
                decoded="${decoded}%"
                encoded="${encoded:3}"
                ;;
            %09*)
                decoded="${decoded}"$'\t'
                encoded="${encoded:3}"
                ;;
            %0D*)
                decoded="${decoded}"$'\r'
                encoded="${encoded:3}"
                ;;
            %0A*)
                decoded="${decoded}"$'\n'
                encoded="${encoded:3}"
                ;;
            %*)
                return 1
                ;;
            *)
                character="${encoded:0:1}"
                decoded="${decoded}${character}"
                encoded="${encoded:1}"
                ;;
        esac
    done
    STATE_DECODED="$decoded"
}

function encode_session_path_marker {
    state_encode_field "$1"
    SESSION_PATH_MARKER="${SESSION_PATH_MARKER_PREFIX}${STATE_ENCODED}"
}

function parse_state_sequence {
    local value="$1"

    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        return 1
    fi
    while [[ "${#value}" -gt 1 ]] && [[ "${value:0:1}" == "0" ]]; do
        value="${value:1}"
    done
    if (( ${#value} > 18 )) || \
        (( 10#$value > STATE_SEQUENCE_MAX )); then
        return 1
    fi
    STATE_PARSED_SEQUENCE=$((10#$value))
}

function reset_loaded_state {
    STATE_SEQUENCE=0
    STATE_SESSION_SERVERS=()
    STATE_SESSION_NAMES=()
    STATE_SESSION_SEQUENCES=()
    STATE_RECENT_KINDS=()
    STATE_RECENT_PATHS=()
    STATE_RECENT_SEQUENCES=()
}

function insert_state_session {
    local event_sequence="$1"
    local server_identity="$2"
    local session_name="$3"
    local candidate_server=""
    local server_count=0
    local index=0
    local inserted=0
    local -a candidate_servers=()
    local -a candidate_names=()
    local -a candidate_sequences=()
    local -a new_servers=()
    local -a new_names=()
    local -a new_sequences=()
    local -A server_counts=()

    for index in "${!STATE_SESSION_NAMES[@]}"; do
        if [[ "${STATE_SESSION_SERVERS[$index]}" == "$server_identity" ]] && \
            [[ "${STATE_SESSION_NAMES[$index]}" == "$session_name" ]] && \
            (( STATE_SESSION_SEQUENCES[index] >= event_sequence )); then
            return 0
        fi
    done
    for index in "${!STATE_SESSION_NAMES[@]}"; do
        if [[ "${STATE_SESSION_SERVERS[$index]}" == "$server_identity" ]] && \
            [[ "${STATE_SESSION_NAMES[$index]}" == "$session_name" ]]; then
            continue
        fi
        if (( ! inserted )) && \
            (( event_sequence > STATE_SESSION_SEQUENCES[index] )); then
            candidate_servers+=("$server_identity")
            candidate_names+=("$session_name")
            candidate_sequences+=("$event_sequence")
            inserted=1
        fi
        candidate_servers+=("${STATE_SESSION_SERVERS[$index]}")
        candidate_names+=("${STATE_SESSION_NAMES[$index]}")
        candidate_sequences+=("${STATE_SESSION_SEQUENCES[$index]}")
    done
    if (( ! inserted )); then
        candidate_servers+=("$server_identity")
        candidate_names+=("$session_name")
        candidate_sequences+=("$event_sequence")
    fi
    for index in "${!candidate_names[@]}"; do
        candidate_server="${candidate_servers[$index]}"
        server_count="${server_counts[$candidate_server]:-0}"
        if (( server_count >= 2 )); then
            continue
        fi
        new_servers+=("$candidate_server")
        new_names+=("${candidate_names[$index]}")
        new_sequences+=("${candidate_sequences[$index]}")
        server_counts["$candidate_server"]=$((server_count + 1))
    done
    STATE_SESSION_SERVERS=("${new_servers[@]}")
    STATE_SESSION_NAMES=("${new_names[@]}")
    STATE_SESSION_SEQUENCES=("${new_sequences[@]}")
}

function insert_state_recent {
    local event_sequence="$1"
    local path_kind="$2"
    local canonical_path="$3"
    local effective_kind="$path_kind"
    local index=0
    local inserted=0
    local -a new_kinds=()
    local -a new_paths=()
    local -a new_sequences=()

    for index in "${!STATE_RECENT_PATHS[@]}"; do
        if [[ "${STATE_RECENT_PATHS[$index]}" == "$canonical_path" ]] && \
            (( STATE_RECENT_SEQUENCES[index] >= event_sequence )); then
            return 0
        fi
        if [[ "${STATE_RECENT_PATHS[$index]}" == "$canonical_path" ]]; then
            effective_kind="${STATE_RECENT_KINDS[$index]}"
        fi
    done
    for index in "${!STATE_RECENT_PATHS[@]}"; do
        if [[ "${STATE_RECENT_PATHS[$index]}" == "$canonical_path" ]]; then
            continue
        fi
        if (( ! inserted )) && \
            (( event_sequence > STATE_RECENT_SEQUENCES[index] )); then
            new_kinds+=("$effective_kind")
            new_paths+=("$canonical_path")
            new_sequences+=("$event_sequence")
            inserted=1
        fi
        if (( ${#new_paths[@]} < STATE_RECENT_LIMIT )); then
            new_kinds+=("${STATE_RECENT_KINDS[$index]}")
            new_paths+=("${STATE_RECENT_PATHS[$index]}")
            new_sequences+=("${STATE_RECENT_SEQUENCES[$index]}")
        fi
    done
    if (( ! inserted )) && (( ${#new_paths[@]} < STATE_RECENT_LIMIT )); then
        new_kinds+=("$effective_kind")
        new_paths+=("$canonical_path")
        new_sequences+=("$event_sequence")
    fi
    STATE_RECENT_KINDS=("${new_kinds[@]}")
    STATE_RECENT_PATHS=("${new_paths[@]}")
    STATE_RECENT_SEQUENCES=("${new_sequences[@]}")
}

function load_state_locked {
    local line=""
    local record_type=""
    local remainder=""
    local sequence_text=""
    local encoded_value=""
    local encoded_server=""
    local encoded_session=""
    local decoded_server=""
    local decoded_session=""
    local decoded_path=""
    local path_kind=""
    local version_value=""
    local version_count=0
    local event_sequence=0
    local -a lines=()

    reset_loaded_state
    if [[ ! -e "$STATE_FILE" ]]; then
        return 0
    fi
    if [[ -L "$STATE_FILE" ]] || [[ ! -f "$STATE_FILE" ]] || \
        [[ ! -r "$STATE_FILE" ]]; then
        return 3
    fi
    mapfile -t lines < "$STATE_FILE"
    for line in "${lines[@]}"; do
        if [[ "$line" == version$'\t'* ]]; then
            version_value="${line#*$'\t'}"
            version_count=$((version_count + 1))
        fi
    done
    if (( version_count != 1 )) || \
        { [[ "$version_value" != "$STATE_VERSION" ]] && \
            [[ "$version_value" != "$STATE_LEGACY_VERSION" ]]; }; then
        reset_loaded_state
        return 3
    fi

    for line in "${lines[@]}"; do
        if [[ "$line" != *$'\t'* ]]; then
            continue
        fi
        record_type="${line%%$'\t'*}"
        remainder="${line#*$'\t'}"
        case "$record_type" in
            sequence)
                if [[ "$remainder" == *$'\t'* ]] || \
                    ! parse_state_sequence "$remainder"; then
                    continue
                fi
                if (( STATE_PARSED_SEQUENCE > STATE_SEQUENCE )); then
                    STATE_SEQUENCE=$STATE_PARSED_SEQUENCE
                fi
                ;;
            session)
                if [[ "$version_value" != "$STATE_VERSION" ]] || \
                    [[ "$remainder" != *$'\t'* ]]; then
                    continue
                fi
                sequence_text="${remainder%%$'\t'*}"
                remainder="${remainder#*$'\t'}"
                if [[ "$remainder" != *$'\t'* ]] || \
                    ! parse_state_sequence "$sequence_text"; then
                    continue
                fi
                event_sequence=$STATE_PARSED_SEQUENCE
                encoded_server="${remainder%%$'\t'*}"
                encoded_session="${remainder#*$'\t'}"
                if [[ "$encoded_session" == *$'\t'* ]] || \
                    ! state_decode_field "$encoded_server" || \
                    [[ "$STATE_DECODED" != /* ]]; then
                    continue
                fi
                decoded_server="$STATE_DECODED"
                if ! state_decode_field "$encoded_session" || \
                    [[ -z "$STATE_DECODED" ]]; then
                    continue
                fi
                decoded_session="$STATE_DECODED"
                insert_state_session "$event_sequence" "$decoded_server" \
                    "$decoded_session"
                if (( event_sequence > STATE_SEQUENCE )); then
                    STATE_SEQUENCE=$event_sequence
                fi
                ;;
            recent)
                if [[ "$remainder" != *$'\t'* ]]; then
                    continue
                fi
                sequence_text="${remainder%%$'\t'*}"
                if ! parse_state_sequence "$sequence_text"; then
                    continue
                fi
                event_sequence=$STATE_PARSED_SEQUENCE
                remainder="${remainder#*$'\t'}"
                if [[ "$version_value" == "$STATE_VERSION" ]]; then
                    if [[ "$remainder" != *$'\t'* ]]; then
                        continue
                    fi
                    path_kind="${remainder%%$'\t'*}"
                    encoded_value="${remainder#*$'\t'}"
                    if [[ "$encoded_value" == *$'\t'* ]] || \
                        { [[ "$path_kind" != "git" ]] && \
                            [[ "$path_kind" != "plain" ]]; }; then
                        continue
                    fi
                else
                    path_kind=""
                    encoded_value="$remainder"
                    if [[ "$encoded_value" == *$'\t'* ]]; then
                        continue
                    fi
                fi
                if ! state_decode_field "$encoded_value"; then
                    continue
                fi
                decoded_path="$STATE_DECODED"
                if [[ "$decoded_path" != /* ]]; then
                    continue
                fi
                if [[ "$version_value" == "$STATE_LEGACY_VERSION" ]]; then
                    if ! classify_path_identity "$decoded_path"; then
                        continue
                    fi
                    path_kind="$PATH_IDENTITY_KIND"
                fi
                insert_state_recent "$event_sequence" "$path_kind" \
                    "$decoded_path"
                if (( event_sequence > STATE_SEQUENCE )); then
                    STATE_SEQUENCE=$event_sequence
                fi
                ;;
        esac
    done
}

function write_state_locked {
    local temporary_file=""
    local encoded_server=""
    local encoded_session=""
    local index=0

    if ! temporary_file=$("$MKTEMP_BIN" \
        "$STATE_DIRECTORY/.state.tmp.XXXXXXXXXX"); then
        fail "cannot create a temporary state record"
        return
    fi
    if ! "$CHMOD_BIN" 0600 -- "$temporary_file"; then
        "$RM_BIN" -f -- "$temporary_file"
        fail "cannot set temporary state record mode"
        return
    fi
    if ! {
        printf 'version\t%s\n' "$STATE_VERSION"
        printf 'sequence\t%d\n' "$STATE_SEQUENCE"
        for index in "${!STATE_SESSION_NAMES[@]}"; do
            state_encode_field "${STATE_SESSION_SERVERS[$index]}"
            encoded_server="$STATE_ENCODED"
            state_encode_field "${STATE_SESSION_NAMES[$index]}"
            encoded_session="$STATE_ENCODED"
            printf 'session\t%d\t%s\t%s\n' \
                "${STATE_SESSION_SEQUENCES[$index]}" "$encoded_server" \
                "$encoded_session"
        done
        for index in "${!STATE_RECENT_PATHS[@]}"; do
            state_encode_field "${STATE_RECENT_PATHS[$index]}"
            printf 'recent\t%d\t%s\t%s\n' \
                "${STATE_RECENT_SEQUENCES[$index]}" \
                "${STATE_RECENT_KINDS[$index]}" "$STATE_ENCODED"
        done
    } > "$temporary_file"; then
        "$RM_BIN" -f -- "$temporary_file"
        fail "cannot write temporary state record"
        return
    fi
    if ! "$MV_BIN" -f -- "$temporary_file" "$STATE_FILE"; then
        "$RM_BIN" -f -- "$temporary_file"
        fail "cannot replace state record"
        return
    fi
}

function parse_pending_record {
    local pending_file="$1"
    local expected_transaction="$2"
    local line=""
    local record_type=""
    local value=""
    local version_value=""
    local transaction_value=""
    local sequence_value=""
    local server_value=""
    local session_value=""
    local path_value=""
    local kind_value=""
    local version_count=0
    local transaction_count=0
    local sequence_count=0
    local server_count=0
    local session_count=0
    local path_count=0
    local kind_count=0
    local -a lines=()

    PENDING_STAGE_SEQUENCE=0
    PENDING_SESSION_SERVER=""
    PENDING_SESSION_NAME=""
    PENDING_SESSION_PATH=""
    PENDING_PATH_KIND=""
    if [[ -L "$pending_file" ]] || [[ ! -f "$pending_file" ]] || \
        [[ ! -r "$pending_file" ]]; then
        return 1
    fi
    mapfile -t lines < "$pending_file"
    for line in "${lines[@]}"; do
        if [[ "$line" != *$'\t'* ]]; then
            return 1
        fi
        record_type="${line%%$'\t'*}"
        value="${line#*$'\t'}"
        if [[ "$value" == *$'\t'* ]]; then
            return 1
        fi
        case "$record_type" in
            version)
                version_value="$value"
                version_count=$((version_count + 1))
                ;;
            transaction)
                transaction_value="$value"
                transaction_count=$((transaction_count + 1))
                ;;
            sequence)
                sequence_value="$value"
                sequence_count=$((sequence_count + 1))
                ;;
            server)
                server_value="$value"
                server_count=$((server_count + 1))
                ;;
            session)
                session_value="$value"
                session_count=$((session_count + 1))
                ;;
            path)
                path_value="$value"
                path_count=$((path_count + 1))
                ;;
            kind)
                kind_value="$value"
                kind_count=$((kind_count + 1))
                ;;
            *)
                return 1
                ;;
        esac
    done
    if (( version_count != 1 || transaction_count != 1 || \
        sequence_count != 1 || server_count != 1 || \
        session_count != 1 || path_count != 1 || kind_count != 1 )); then
        return 1
    fi
    if [[ "$version_value" != "$STATE_VERSION" ]] || \
        [[ "$transaction_value" != "$expected_transaction" ]] || \
        [[ ! "$transaction_value" =~ ^[A-Za-z0-9_-]+$ ]] || \
        ! parse_state_sequence "$sequence_value"; then
        return 1
    fi
    PENDING_STAGE_SEQUENCE=$STATE_PARSED_SEQUENCE
    if ! state_decode_field "$server_value" || \
        [[ "$STATE_DECODED" != /* ]]; then
        return 1
    fi
    PENDING_SESSION_SERVER="$STATE_DECODED"
    if ! state_decode_field "$session_value" || [[ -z "$STATE_DECODED" ]]; then
        return 1
    fi
    PENDING_SESSION_NAME="$STATE_DECODED"
    if ! state_decode_field "$path_value"; then
        return 1
    fi
    if [[ -n "$STATE_DECODED" ]] && [[ "$STATE_DECODED" != /* ]]; then
        return 1
    fi
    PENDING_SESSION_PATH="$STATE_DECODED"
    if [[ -n "$kind_value" ]] && [[ "$kind_value" != "git" ]] && \
        [[ "$kind_value" != "plain" ]]; then
        return 1
    fi
    if [[ -z "$PENDING_SESSION_PATH" ]] && [[ -n "$kind_value" ]]; then
        return 1
    fi
    PENDING_PATH_KIND="$kind_value"
}

function parse_ack_record {
    local ack_file="$1"
    local expected_transaction="$2"
    local line=""
    local record_type=""
    local value=""
    local version_value=""
    local transaction_value=""
    local sequence_value=""
    local version_count=0
    local transaction_count=0
    local sequence_count=0
    local -a lines=()

    PENDING_EVENT_SEQUENCE=0
    if [[ -L "$ack_file" ]] || [[ ! -f "$ack_file" ]] || \
        [[ ! -r "$ack_file" ]]; then
        return 1
    fi
    mapfile -t lines < "$ack_file"
    for line in "${lines[@]}"; do
        if [[ "$line" != *$'\t'* ]]; then
            return 1
        fi
        record_type="${line%%$'\t'*}"
        value="${line#*$'\t'}"
        if [[ "$value" == *$'\t'* ]]; then
            return 1
        fi
        case "$record_type" in
            version)
                version_value="$value"
                version_count=$((version_count + 1))
                ;;
            transaction)
                transaction_value="$value"
                transaction_count=$((transaction_count + 1))
                ;;
            sequence)
                sequence_value="$value"
                sequence_count=$((sequence_count + 1))
                ;;
            *)
                return 1
                ;;
        esac
    done
    if (( version_count != 1 || transaction_count != 1 || \
        sequence_count != 1 )); then
        return 1
    fi
    if [[ "$version_value" != "$STATE_VERSION" ]] || \
        { [[ -n "$expected_transaction" ]] && \
            [[ "$transaction_value" != "$expected_transaction" ]]; } || \
        [[ ! "$transaction_value" =~ ^[A-Za-z0-9_-]+$ ]] || \
        ! parse_state_sequence "$sequence_value"; then
        return 1
    fi
    PENDING_EVENT_SEQUENCE=$STATE_PARSED_SEQUENCE
}

function transaction_is_active {
    local transaction_id="$1"
    local pending_file="$STATE_DIRECTORY/pending.$transaction_id"
    local pending_fd=""

    if [[ ! -f "$pending_file" ]] || [[ -L "$pending_file" ]] || \
        ! exec {pending_fd}<"$pending_file"; then
        return 1
    fi
    if "$FLOCK_BIN" -x -n "$pending_fd"; then
        "$FLOCK_BIN" -u "$pending_fd"
        exec {pending_fd}>&-
        return 1
    fi
    exec {pending_fd}>&-
    return 0
}

function remove_transaction_ack_work_files {
    local transaction_id="$1"
    local nullglob_was_set=0
    local -a temporary_files=()

    if shopt -q nullglob; then
        nullglob_was_set=1
    fi
    shopt -s nullglob
    temporary_files=("$STATE_DIRECTORY"/.ack.tmp."$transaction_id".*)
    if (( ${#temporary_files[@]} > 0 )); then
        "$RM_BIN" -f -- "${temporary_files[@]}"
    fi
    if (( ! nullglob_was_set )); then
        shopt -u nullglob
    fi
}

function cleanup_ack_work_files_locked {
    local work_file=""
    local basename=""
    local transaction_id=""
    local pending_file=""
    local has_active_transaction=0
    local nullglob_was_set=0
    local -a temporary_files=()
    local -a ticket_files=()
    local -a pending_files=()

    if shopt -q nullglob; then
        nullglob_was_set=1
    fi
    shopt -s nullglob
    temporary_files=("$STATE_DIRECTORY"/.ack.tmp.*)
    for work_file in "${temporary_files[@]}"; do
        basename="${work_file##*/.ack.tmp.}"
        transaction_id="${basename%%.*}"
        if [[ ! "$transaction_id" =~ ^[A-Za-z0-9_-]+$ ]] || \
            ! transaction_is_active "$transaction_id"; then
            "$RM_BIN" -f -- "$work_file"
        fi
    done
    pending_files=("$STATE_DIRECTORY"/pending.*)
    for pending_file in "${pending_files[@]}"; do
        transaction_id="${pending_file##*/pending.}"
        if transaction_is_active "$transaction_id"; then
            has_active_transaction=1
            break
        fi
    done
    if (( ! has_active_transaction )); then
        ticket_files=("$STATE_DIRECTORY"/.ack.ticket.*)
        if (( ${#ticket_files[@]} > 0 )); then
            "$RM_BIN" -f -- "${ticket_files[@]}"
        fi
    fi
    if (( ! nullglob_was_set )); then
        shopt -u nullglob
    fi
}

function apply_pending_event_locked {
    if (( PENDING_EVENT_SEQUENCE > STATE_SEQUENCE )); then
        STATE_SEQUENCE=$PENDING_EVENT_SEQUENCE
    fi
    insert_state_session "$PENDING_EVENT_SEQUENCE" \
        "$PENDING_SESSION_SERVER" "$PENDING_SESSION_NAME"
    if [[ -n "$PENDING_SESSION_PATH" ]] && \
        [[ -n "$PENDING_PATH_KIND" ]]; then
        insert_state_recent "$PENDING_EVENT_SEQUENCE" \
            "$PENDING_PATH_KIND" "$PENDING_SESSION_PATH"
    fi
    write_state_locked
}

function reconcile_orphan_transactions_locked {
    local pending_file=""
    local ack_file=""
    local transaction_id=""
    local pending_fd=""
    local nullglob_was_set=0
    local -a pending_files=()
    local -a ack_files=()
    local -a temporary_files=()

    if shopt -q nullglob; then
        nullglob_was_set=1
    fi
    shopt -s nullglob
    temporary_files=(
        "$STATE_DIRECTORY"/.state.tmp.*
        "$STATE_DIRECTORY"/.pending.*
    )
    if (( ${#temporary_files[@]} > 0 )); then
        "$RM_BIN" -f -- "${temporary_files[@]}"
    fi
    pending_files=("$STATE_DIRECTORY"/pending.*)
    for pending_file in "${pending_files[@]}"; do
        transaction_id="${pending_file##*/pending.}"
        ack_file="$STATE_DIRECTORY/ack.$transaction_id"
        pending_fd=""
        if ! exec {pending_fd}<"$pending_file"; then
            continue
        fi
        if "$FLOCK_BIN" -x -n "$pending_fd"; then
            if parse_pending_record "$pending_file" "$transaction_id" && \
                parse_ack_record "$ack_file" "$transaction_id"; then
                if ! apply_pending_event_locked; then
                    "$FLOCK_BIN" -u "$pending_fd"
                    exec {pending_fd}>&-
                    if (( ! nullglob_was_set )); then
                        shopt -u nullglob
                    fi
                    return 1
                fi
                remove_transaction_ack_work_files "$transaction_id"
            else
                remove_transaction_ack_work_files "$transaction_id"
            fi
            "$RM_BIN" -f -- "$pending_file" "$ack_file"
            "$FLOCK_BIN" -u "$pending_fd"
        fi
        exec {pending_fd}>&-
    done

    ack_files=("$STATE_DIRECTORY"/ack.*)
    for ack_file in "${ack_files[@]}"; do
        transaction_id="${ack_file##*/ack.}"
        pending_file="$STATE_DIRECTORY/pending.$transaction_id"
        if [[ ! -e "$pending_file" ]]; then
            "$RM_BIN" -f -- "$ack_file"
        fi
    done
    cleanup_ack_work_files_locked
    if (( ! nullglob_was_set )); then
        shopt -u nullglob
    fi
}

function load_state_access {
    local load_rc=0

    acquire_state_lock || return
    load_state_locked || load_rc=$?
    if (( load_rc == 3 )); then
        release_state_lock
        fail "state version is incompatible or unreadable: $STATE_FILE"
        return
    fi
    if (( load_rc != 0 )); then
        release_state_lock
        return "$load_rc"
    fi
    if ! reconcile_orphan_transactions_locked; then
        release_state_lock
        return 1
    fi
    release_state_lock
}

function initialize_state_runtime {
    require_state_dependencies || return
    ensure_state_directory || return
    load_state_access
}

function next_event_sequence_locked {
    local pending_file=""
    local ack_file=""
    local transaction_id=""
    local maximum_sequence="$STATE_SEQUENCE"
    local nullglob_was_set=0
    local -a pending_files=()
    local -a ack_files=()
    local -a ticket_files=()

    if shopt -q nullglob; then
        nullglob_was_set=1
    fi
    shopt -s nullglob
    pending_files=("$STATE_DIRECTORY"/pending.*)
    for pending_file in "${pending_files[@]}"; do
        transaction_id="${pending_file##*/pending.}"
        if parse_pending_record "$pending_file" "$transaction_id" && \
            (( PENDING_STAGE_SEQUENCE > maximum_sequence )); then
            maximum_sequence=$PENDING_STAGE_SEQUENCE
        fi
    done
    ack_files=("$STATE_DIRECTORY"/ack.*)
    for ack_file in "${ack_files[@]}"; do
        transaction_id="${ack_file##*/ack.}"
        if parse_ack_record "$ack_file" "$transaction_id" && \
            (( PENDING_EVENT_SEQUENCE > maximum_sequence )); then
            maximum_sequence=$PENDING_EVENT_SEQUENCE
        fi
    done
    ticket_files=("$STATE_DIRECTORY"/.ack.ticket.*)
    for ack_file in "${ticket_files[@]}"; do
        if parse_ack_record "$ack_file" "" && \
            (( PENDING_EVENT_SEQUENCE > maximum_sequence )); then
            maximum_sequence=$PENDING_EVENT_SEQUENCE
        fi
    done
    if (( ! nullglob_was_set )); then
        shopt -u nullglob
    fi
    if (( maximum_sequence >= STATE_SEQUENCE_MAX )); then
        fail "state sequence is exhausted"
        return
    fi
    STATE_EVENT_SEQUENCE=$((maximum_sequence + 1))
}

function write_ack_record {
    local transaction_id="$1"
    local ack_file="$STATE_DIRECTORY/ack.$transaction_id"
    local temporary_file=""
    local ticket_file=""
    local load_rc=0
    local attempts=0

    if [[ -e "$ack_file" ]]; then
        if parse_ack_record "$ack_file" "$transaction_id"; then
            STATE_ACK_FILE="$ack_file"
            return 0
        fi
        fail "state acknowledgment is malformed: $ack_file"
        return
    fi
    while (( attempts < 100 )); do
        attempts=$((attempts + 1))
        load_rc=0
        load_state_locked || load_rc=$?
        if (( load_rc != 0 )); then
            fail "cannot read state while creating an acknowledgment"
            return 1
        fi
        next_event_sequence_locked || return
        if ! temporary_file=$("$MKTEMP_BIN" \
            "$STATE_DIRECTORY/.ack.tmp.$transaction_id.XXXXXXXXXX"); then
            fail "cannot create a temporary state acknowledgment"
            return
        fi
        if ! {
            printf 'version\t%s\n' "$STATE_VERSION"
            printf 'transaction\t%s\n' "$transaction_id"
            printf 'sequence\t%d\n' "$STATE_EVENT_SEQUENCE"
        } > "$temporary_file" || \
            ! "$CHMOD_BIN" 0600 -- "$temporary_file"; then
            "$RM_BIN" -f -- "$temporary_file"
            fail "cannot write a state acknowledgment"
            return
        fi
        ticket_file="$STATE_DIRECTORY/.ack.ticket.$STATE_EVENT_SEQUENCE"
        if ! "$LN_BIN" -- "$temporary_file" "$ticket_file"; then
            "$RM_BIN" -f -- "$temporary_file"
            if [[ -e "$ticket_file" ]] && \
                ! parse_ack_record "$ticket_file" ""; then
                "$RM_BIN" -f -- "$ticket_file"
            fi
            continue
        fi
        if "$LN_BIN" -- "$temporary_file" "$ack_file"; then
            "$RM_BIN" -f -- "$temporary_file"
            STATE_ACK_FILE="$ack_file"
            return 0
        fi
        "$RM_BIN" -f -- "$temporary_file"
        if parse_ack_record "$ack_file" "$transaction_id"; then
            STATE_ACK_FILE="$ack_file"
            return 0
        fi
        fail "cannot publish a state acknowledgment"
        return
    done
    fail "cannot allocate a state acknowledgment sequence"
    return 1
}

function stage_state_event {
    local session_name="$1"
    local session_path="$2"
    local path_kind="${3:-}"
    local temporary_file=""
    local transaction_id=""
    local pending_file=""
    local ack_file=""
    local server_identity=""
    local encoded_server=""
    local encoded_session=""
    local encoded_path=""
    local load_rc=0
    local attempts=0
    local published=0

    server_identity=$(runner_socket_path)
    if [[ -z "$server_identity" ]]; then
        fail "cannot resolve the runner server identity"
        return
    fi
    if [[ -n "$session_path" ]] && [[ -z "$path_kind" ]] && \
        classify_path_identity "$session_path"; then
        path_kind="$PATH_IDENTITY_KIND"
    fi
    acquire_state_lock || return
    load_state_locked || load_rc=$?
    if (( load_rc == 3 )); then
        release_state_lock
        fail "state version is incompatible or unreadable: $STATE_FILE"
        return
    fi
    if (( load_rc != 0 )); then
        release_state_lock
        return "$load_rc"
    fi
    if ! reconcile_orphan_transactions_locked || \
        ! next_event_sequence_locked; then
        release_state_lock
        return 1
    fi
    while (( attempts < 100 )); do
        attempts=$((attempts + 1))
        if ! temporary_file=$("$MKTEMP_BIN" \
            "$STATE_DIRECTORY/.pending.XXXXXXXXXX"); then
            release_state_lock
            fail "cannot create a pending state event"
            return
        fi
        transaction_id="${temporary_file##*/.pending.}"
        pending_file="$STATE_DIRECTORY/pending.$transaction_id"
        ack_file="$STATE_DIRECTORY/ack.$transaction_id"
        state_encode_field "$server_identity"
        encoded_server="$STATE_ENCODED"
        state_encode_field "$session_name"
        encoded_session="$STATE_ENCODED"
        state_encode_field "$session_path"
        encoded_path="$STATE_ENCODED"
        if ! {
            printf 'version\t%s\n' "$STATE_VERSION"
            printf 'transaction\t%s\n' "$transaction_id"
            printf 'sequence\t%d\n' "$STATE_EVENT_SEQUENCE"
            printf 'server\t%s\n' "$encoded_server"
            printf 'session\t%s\n' "$encoded_session"
            printf 'path\t%s\n' "$encoded_path"
            printf 'kind\t%s\n' "$path_kind"
        } > "$temporary_file" || \
            ! "$CHMOD_BIN" 0600 -- "$temporary_file"; then
            "$RM_BIN" -f -- "$temporary_file"
            release_state_lock
            fail "cannot write a pending state event"
            return
        fi
        if "$LN_BIN" -- "$temporary_file" "$pending_file"; then
            "$RM_BIN" -f -- "$temporary_file"
            published=1
            break
        fi
        "$RM_BIN" -f -- "$temporary_file"
        if [[ ! -e "$pending_file" ]]; then
            release_state_lock
            fail "cannot publish a pending state event"
            return
        fi
    done
    if (( ! published )); then
        release_state_lock
        fail "cannot allocate a pending transaction identifier"
        return
    fi
    if ! exec {STATE_EVENT_FD}<"$pending_file" || \
        ! "$FLOCK_BIN" -s -n "$STATE_EVENT_FD"; then
        "$RM_BIN" -f -- "$pending_file"
        if [[ -n "$STATE_EVENT_FD" ]]; then
            exec {STATE_EVENT_FD}>&-
        fi
        STATE_EVENT_FD=""
        release_state_lock
        fail "cannot lock a pending state event"
        return
    fi
    STATE_TRANSACTION_ID="$transaction_id"
    STATE_PENDING_FILE="$pending_file"
    STATE_ACK_FILE="$ack_file"
    STATE_EVENT_SERVER="$server_identity"
    STATE_EVENT_SESSION_NAME="$session_name"
    STATE_EVENT_SESSION_PATH="$session_path"
    STATE_EVENT_PATH_KIND="$path_kind"
    release_state_lock
}

function release_state_event_lock {
    if [[ -n "$STATE_EVENT_FD" ]]; then
        "$FLOCK_BIN" -u "$STATE_EVENT_FD" 2>/dev/null || true
        exec {STATE_EVENT_FD}>&-
    fi
    STATE_EVENT_FD=""
}

function clear_state_event {
    release_state_event_lock
    STATE_PENDING_FILE=""
    STATE_ACK_FILE=""
    STATE_TRANSACTION_ID=""
    STATE_EVENT_SEQUENCE=0
    STATE_EVENT_SERVER=""
    STATE_EVENT_SESSION_NAME=""
    STATE_EVENT_SESSION_PATH=""
    STATE_EVENT_PATH_KIND=""
}

function discard_state_event {
    local discard_rc=0

    if [[ -z "$STATE_TRANSACTION_ID" ]]; then
        return 0
    fi
    settle_state_event 0 || discard_rc=$?
    if (( discard_rc != 0 )); then
        clear_state_event
    fi
    return "$discard_rc"
}

function recover_released_state_event {
    local pending_file="$STATE_PENDING_FILE"

    if load_state_access && [[ ! -e "$pending_file" ]]; then
        clear_state_event
        return 0
    fi
    return 1
}

function settle_state_event {
    local acknowledged="$1"
    local load_rc=0
    local pending_fd=""

    if (( ! acknowledged )); then
        release_state_event_lock
    fi

    acquire_state_lock || return
    load_state_locked || load_rc=$?
    if (( load_rc == 3 )); then
        release_state_lock
        fail "state version is incompatible or unreadable: $STATE_FILE"
        return
    fi
    if (( load_rc != 0 )); then
        release_state_lock
        return "$load_rc"
    fi
    if ! reconcile_orphan_transactions_locked; then
        release_state_lock
        return 1
    fi
    if (( acknowledged )); then
        if ! parse_pending_record "$STATE_PENDING_FILE" \
                "$STATE_TRANSACTION_ID" || \
            ! parse_ack_record "$STATE_ACK_FILE" "$STATE_TRANSACTION_ID" || \
            ! apply_pending_event_locked; then
            release_state_lock
            return 1
        fi
        remove_transaction_ack_work_files "$STATE_TRANSACTION_ID"
        "$RM_BIN" -f -- "$STATE_PENDING_FILE" "$STATE_ACK_FILE"
        release_state_event_lock
        cleanup_ack_work_files_locked
    elif [[ -e "$STATE_PENDING_FILE" ]] && \
        exec {pending_fd}<"$STATE_PENDING_FILE"; then
        if "$FLOCK_BIN" -x -n "$pending_fd"; then
            "$RM_BIN" -f -- "$STATE_PENDING_FILE" "$STATE_ACK_FILE"
            remove_transaction_ack_work_files "$STATE_TRANSACTION_ID"
            "$FLOCK_BIN" -u "$pending_fd"
        fi
        exec {pending_fd}>&-
    fi
    release_state_lock
    clear_state_event
}

function quote_posix_shell {
    local value="$1"
    local quoted="'"
    local character=""

    while [[ -n "$value" ]]; do
        character="${value:0:1}"
        value="${value:1}"
        if [[ "$character" == "'" ]]; then
            quoted="${quoted}'\\''"
        else
            quoted="${quoted}${character}"
        fi
    done
    STATE_SHELL_QUOTED="${quoted}'"
}

function escape_tmux_format_literal {
    local value="$1"
    local escaped=""
    local character=""

    while [[ -n "$value" ]]; do
        character="${value:0:1}"
        value="${value:1}"
        case "$character" in
            '#')
                escaped="${escaped}##"
                ;;
            ',')
                escaped="${escaped}#,"
                ;;
            '}')
                escaped="${escaped}#}"
                ;;
            *)
                escaped="${escaped}${character}"
                ;;
        esac
    done
    TMUX_FORMAT_ESCAPED="$escaped"
}

function prepare_session_entry {
    local command_name="$1"
    local session_id="$2"
    local selected_name="$3"
    local raw_marker="$4"
    local marker_present="$5"
    local escaped_name=""
    local escaped_marker=""
    local quoted_target=""
    local quoted_ack_command=""
    local quoted_hook_name=""
    local quoted_guard_target=""
    local quoted_guard=""
    local quoted_entry_command=""
    local quoted_fallback_marker=""

    SESSION_ENTRY_HOOK_NAME=""
    SESSION_ENTRY_HOOK_COMMAND=""
    SESSION_ENTRY_HOOK_TARGET=""
    if [[ -z "$STATE_TRANSACTION_ID" ]] || \
        [[ ! "$STATE_TRANSACTION_ID" =~ ^[A-Za-z0-9_-]+$ ]]; then
        fail "invalid state transaction identifier for session entry"
        return 1
    fi

    escape_tmux_format_literal "$selected_name"
    escaped_name="$TMUX_FORMAT_ESCAPED"
    if (( ! marker_present )); then
        fail "session marker snapshot is missing: $selected_name"
        return 1
    fi
    escape_tmux_format_literal "$raw_marker"
    escaped_marker="$TMUX_FORMAT_ESCAPED"
    SESSION_ENTRY_GUARD="#{&&:#{==:#{session_name},${escaped_name}},"
    SESSION_ENTRY_GUARD+="#{==:#{@tmux-runner-path},${escaped_marker}}}"

    quote_posix_shell "$session_id"
    quoted_target="$STATE_SHELL_QUOTED"
    quote_posix_shell "$STATE_ACK_COMMAND"
    quoted_ack_command="$STATE_SHELL_QUOTED"
    SESSION_ENTRY_COMMAND="$command_name -t $quoted_target ; run-shell $quoted_ack_command"

    SESSION_ENTRY_HOOK_NAME="${SESSION_ENTRY_HOOK_PREFIX}${STATE_TRANSACTION_ID}"
    SESSION_ENTRY_HOOK_TARGET="${session_id}:"
    quote_posix_shell "$SESSION_ENTRY_HOOK_NAME"
    quoted_hook_name="$STATE_SHELL_QUOTED"
    quote_posix_shell "$SESSION_ENTRY_HOOK_TARGET"
    quoted_guard_target="$STATE_SHELL_QUOTED"
    quote_posix_shell "$SESSION_ENTRY_GUARD"
    quoted_guard="$STATE_SHELL_QUOTED"
    quote_posix_shell "$SESSION_ENTRY_COMMAND"
    quoted_entry_command="$STATE_SHELL_QUOTED"
    quote_posix_shell "$SESSION_PATH_GLOBAL_FALLBACK_MARKER"
    quoted_fallback_marker="$STATE_SHELL_QUOTED"
    SESSION_ENTRY_HOOK_COMMAND="set-hook -u -t $quoted_guard_target "
    SESSION_ENTRY_HOOK_COMMAND+="$quoted_hook_name ; "
    SESSION_ENTRY_HOOK_COMMAND+="set-option -gq @tmux-runner-path "
    SESSION_ENTRY_HOOK_COMMAND+="$quoted_fallback_marker ; "
    SESSION_ENTRY_HOOK_COMMAND+="if-shell -F -t $quoted_guard_target "
    SESSION_ENTRY_HOOK_COMMAND+="$quoted_guard $quoted_entry_command"
}

function runner_executable_path {
    local source_path="${BASH_SOURCE[0]}"
    local source_directory=""

    if [[ "$source_path" != */* ]]; then
        source_path=$(type -P -- "$source_path" || true)
    fi
    if [[ -z "$source_path" ]] || [[ "$source_path" != */* ]]; then
        return 1
    fi
    source_directory="${source_path%/*}"
    if ! source_directory=$(cd -- "$source_directory" 2>/dev/null && pwd -P); then
        return 1
    fi
    printf '%s/%s\n' "$source_directory" "${source_path##*/}"
}

function build_state_ack_command {
    local session_id="$1"
    local executable_path=""
    local quoted_executable=""
    local quoted_directory=""
    local quoted_transaction=""
    local quoted_socket_root=""
    local quoted_session_id=""
    local socket_root="${TMUX_TMPDIR:-/tmp}"

    if ! executable_path=$(runner_executable_path); then
        fail "cannot resolve the runner executable for state acknowledgment"
        return
    fi
    quote_posix_shell "$executable_path"
    quoted_executable="$STATE_SHELL_QUOTED"
    quote_posix_shell "$STATE_DIRECTORY"
    quoted_directory="$STATE_SHELL_QUOTED"
    quote_posix_shell "$STATE_TRANSACTION_ID"
    quoted_transaction="$STATE_SHELL_QUOTED"
    quote_posix_shell "$socket_root"
    quoted_socket_root="$STATE_SHELL_QUOTED"
    quote_posix_shell "$session_id"
    quoted_session_id="$STATE_SHELL_QUOTED"
    STATE_ACK_COMMAND="$quoted_executable __state-ack $quoted_directory"
    STATE_ACK_COMMAND+=" $quoted_transaction $quoted_socket_root"
    STATE_ACK_COMMAND+=" $quoted_session_id"
    STATE_ACK_COMMAND="${STATE_ACK_COMMAND//#/##}"
}

function acknowledge_state_transaction {
    local state_directory="$1"
    local transaction_id="$2"
    local socket_root="$3"
    local session_id="$4"
    local pending_file=""
    local expected_server=""
    local expected_session=""
    local expected_path=""
    local current_session=""
    local current_path=""
    local pending_fd=""
    local marker_rc=0

    if [[ "$state_directory" != /* ]] || \
        [[ ! "$transaction_id" =~ ^[A-Za-z0-9_-]+$ ]] || \
        [[ ! "$session_id" =~ ^\$[0-9]+$ ]] || \
        [[ -L "$state_directory" ]] || [[ ! -d "$state_directory" ]] || \
        [[ ! -O "$state_directory" ]]; then
        return 1
    fi
    require_state_dependencies || return
    if [[ -z "$TMUX_BIN" ]] || [[ ! -x "$TMUX_BIN" ]] || \
        [[ "$socket_root" != /* ]]; then
        return 1
    fi
    export TMUX_TMPDIR="$socket_root"
    STATE_DIRECTORY="$state_directory"
    STATE_FILE="$STATE_DIRECTORY/state"
    pending_file="$STATE_DIRECTORY/pending.$transaction_id"
    if ! exec {pending_fd}<"$pending_file" || \
        ! "$FLOCK_BIN" -s -n "$pending_fd"; then
        if [[ -n "$pending_fd" ]]; then
            exec {pending_fd}>&-
        fi
        return 1
    fi
    if ! parse_pending_record "$pending_file" "$transaction_id"; then
        "$FLOCK_BIN" -u "$pending_fd"
        exec {pending_fd}>&-
        return 1
    fi
    expected_server=$(runner_socket_path)
    if [[ "$PENDING_SESSION_SERVER" != "$expected_server" ]]; then
        "$FLOCK_BIN" -u "$pending_fd"
        exec {pending_fd}>&-
        return 1
    fi
    expected_session="$PENDING_SESSION_NAME"
    expected_path="$PENDING_SESSION_PATH"
    if ! current_session=$(run_tmux_command display-message -p \
            -t "${session_id}:" '#{session_name}' 2>/dev/null) || \
        [[ "$current_session" != "$expected_session" ]]; then
        "$FLOCK_BIN" -u "$pending_fd"
        exec {pending_fd}>&-
        return 1
    fi
    if load_session_path_option_target "${session_id}:"; then
        current_path="$SESSION_PATH_VALUE"
    else
        marker_rc=$?
        if (( marker_rc != 1 )) || [[ -n "$expected_path" ]]; then
            "$FLOCK_BIN" -u "$pending_fd"
            exec {pending_fd}>&-
            return 1
        fi
    fi
    if [[ "$current_path" != "$expected_path" ]] || \
        ! write_ack_record "$transaction_id"; then
        "$FLOCK_BIN" -u "$pending_fd"
        exec {pending_fd}>&-
        return 1
    fi
    "$FLOCK_BIN" -u "$pending_fd"
    exec {pending_fd}>&-
}

function normalize_session_name {
    local session_name="$1"

    session_name="${session_name//./_}"
    session_name="${session_name//:/_}"
    printf '%s\n' "$session_name"
}

function resolve_working_path {
    local directory="$1"
    local git_top=""
    local resolved_top=""

    if [[ -z "$GIT_BIN" ]] || [[ ! -x "$GIT_BIN" ]]; then
        fail "git is not available in PATH"
        return
    fi
    if git_top=$("$GIT_BIN" -C "$directory" rev-parse --show-toplevel \
        2>/dev/null); then
        if ! resolved_top=$(cd -- "$git_top" 2>/dev/null && pwd -P); then
            fail "Git top level is not accessible: $git_top"
            return
        fi
        printf '%s\n' "$resolved_top"
    else
        printf '%s\n' "$directory"
    fi
}

function load_managed_sessions {
    local session_name=""
    local -a session_names=()

    MANAGED_SESSION_NAMES=()
    MANAGED_SESSION_PATHS=()
    mapfile -t session_names < <(
        run_tmux_command list-sessions -F '#{session_name}' 2>/dev/null || true
    )
    for session_name in "${session_names[@]}"; do
        if load_session_path_option "$session_name" && \
            [[ -n "$SESSION_PATH_VALUE" ]]; then
            MANAGED_SESSION_NAMES+=("$session_name")
            MANAGED_SESSION_PATHS+=("$SESSION_PATH_VALUE")
        fi
    done
}

function find_path_matches {
    local canonical_path="$1"
    local index=0

    PATH_MATCHES=()
    for index in "${!MANAGED_SESSION_PATHS[@]}"; do
        if [[ "${MANAGED_SESSION_PATHS[$index]}" == "$canonical_path" ]]; then
            PATH_MATCHES+=("${MANAGED_SESSION_NAMES[$index]}")
        fi
    done
}

function report_ambiguous_path {
    local canonical_path="$1"
    local session_name=""

    printf '%s: multiple sessions match path: %s\n' \
        "$PROGRAM_NAME" "$canonical_path" >&2
    for session_name in "${PATH_MATCHES[@]}"; do
        printf '  %s\n' "$session_name" >&2
    done
    return 2
}

function load_session_path_option_target {
    local target="$1"
    local marker=""
    local marker_output=""
    local encoded_path=""

    SESSION_PATH_MARKER=""
    SESSION_PATH_MARKER_PRESENT=0
    SESSION_PATH_VALUE=""
    if ! marker_output=$(
        if run_tmux_command show-options -v -t "$target" \
                @tmux-runner-path 2>/dev/null; then
            printf '\034'
        else
            exit 1
        fi
    ); then
        return 1
    fi
    marker_output="${marker_output%$'\034'}"
    if [[ "$marker_output" == *$'\n' ]]; then
        marker="${marker_output%$'\n'}"
    else
        marker="$marker_output"
    fi
    SESSION_PATH_MARKER_PRESENT=1
    SESSION_PATH_MARKER="$marker"
    if [[ "$marker" == "$SESSION_PATH_UNMARKED_MARKER" ]]; then
        SESSION_PATH_VALUE=""
        return 0
    elif [[ "$marker" == "$SESSION_PATH_MARKER_PREFIX"* ]]; then
        encoded_path="${marker#"$SESSION_PATH_MARKER_PREFIX"}"
        if ! state_decode_field "$encoded_path"; then
            return 2
        fi
        SESSION_PATH_VALUE="$STATE_DECODED"
    else
        SESSION_PATH_VALUE="$marker"
    fi
    if [[ "$SESSION_PATH_VALUE" != /* ]]; then
        return 2
    fi
}

function load_session_path_option {
    local session_name="$1"

    load_session_path_option_target "=$session_name:"
}

function resolve_session_target {
    local session_name="$1"
    local session_id=""
    local marker_rc=0

    SESSION_TARGET_ID=""
    SESSION_TARGET_NAME=""
    if ! session_id=$(run_tmux_command display-message -p \
            -t "=$session_name:" '#{session_id}' 2>/dev/null) || \
        [[ ! "$session_id" =~ ^\$[0-9]+$ ]]; then
        fail "session is no longer available before attachment: $session_name"
        return
    fi
    SESSION_TARGET_ID="$session_id"
    SESSION_TARGET_NAME="$session_name"
    if load_session_path_option_target "${session_id}:"; then
        return 0
    else
        marker_rc=$?
    fi
    if (( marker_rc == 1 )); then
        if ! run_tmux_command set-option -oq -t "${session_id}:" \
                @tmux-runner-path "$SESSION_PATH_UNMARKED_MARKER"; then
            fail "cannot normalize the session path marker: $session_name"
            return 1
        fi
        if load_session_path_option_target "${session_id}:"; then
            return 0
        else
            marker_rc=$?
        fi
        if (( marker_rc == 1 )); then
            fail "session is no longer available before attachment: $session_name"
            return 1
        fi
    fi
    fail "session path marker is invalid: $session_name"
    return 1
}

function revalidate_entry_path {
    local canonical_path="$1"
    local expected_kind="$2"
    local physical_path=""

    if ! physical_path=$(cd -- "$canonical_path" 2>/dev/null && pwd -P); then
        fail "path is no longer accessible before tmux entry: $canonical_path"
        return
    fi
    if [[ "$physical_path" != "$canonical_path" ]]; then
        fail "path identity changed before tmux entry: $canonical_path"
        return
    fi
    if ! classify_path_identity "$canonical_path" || \
        [[ "$PATH_IDENTITY_KIND" != "$expected_kind" ]]; then
        fail "path kind changed before tmux entry: $canonical_path"
        return
    fi
}

function connect_verified_path {
    local session_name="$1"
    local canonical_path="$2"
    local expected_kind="$3"
    if ! load_session_path_option "$session_name" || \
        [[ "$SESSION_PATH_VALUE" != "$canonical_path" ]]; then
        discard_state_event || true
        fail "session identity changed before attachment: $session_name"
        return
    fi
    connect_session "$session_name" "$canonical_path" "$expected_kind"
}

function try_marked_session {
    local session_name="$1"
    local canonical_path="$2"
    local expected_kind="$3"
    local target="=$session_name"
    local marker=""
    local create_output=""
    local create_rc=0

    if run_tmux_command has-session -t "$target" 2>/dev/null; then
        if load_session_path_option "$session_name" && \
            [[ "$SESSION_PATH_VALUE" == "$canonical_path" ]]; then
            return 0
        fi
        discard_state_event || true
        return 3
    fi

    # set-option takes a pane target. The trailing colon keeps the session
    # component exact while selecting its current window.
    encode_session_path_marker "$canonical_path"
    marker="$SESSION_PATH_MARKER"
    stage_state_event "$session_name" "$canonical_path" \
        "$expected_kind" || return
    if ! revalidate_entry_path "$canonical_path" "$expected_kind"; then
        discard_state_event || true
        return 1
    fi
    create_output=$(run_tmux_command new-session -d -s "$session_name" \
        -c "$canonical_path" \; set-option -t "=$session_name:" \
        @tmux-runner-path "$marker" 2>&1) || create_rc=$?
    if (( create_rc == 0 )); then
        return 0
    fi
    if run_tmux_command has-session -t "$target" 2>/dev/null; then
        if load_session_path_option "$session_name" && \
            [[ "$SESSION_PATH_VALUE" == "$canonical_path" ]]; then
            return 0
        fi
        discard_state_event || true
        return 3
    fi
    if [[ -n "$create_output" ]]; then
        printf '%s\n' "$create_output" >&2
    fi
    discard_state_event || true
    return "$create_rc"
}

function report_explicit_conflict {
    local session_name="$1"
    local canonical_path="$2"
    if ! load_session_path_option "$session_name" || \
        [[ -z "$SESSION_PATH_VALUE" ]]; then
        fail "session $session_name exists without @tmux-runner-path; choose another -s name or attach directly"
    else
        fail "session $session_name belongs to $SESSION_PATH_VALUE, not $canonical_path"
    fi
}

function path_parent_count {
    local canonical_path="$1"
    local parent_path=""
    local -a components=()

    if [[ "$canonical_path" == "/" ]]; then
        printf '0\n'
        return 0
    fi
    parent_path="${canonical_path%/*}"
    parent_path="${parent_path#/}"
    if [[ -z "$parent_path" ]]; then
        printf '0\n'
        return 0
    fi
    IFS='/' read -r -a components <<< "$parent_path"
    printf '%d\n' "${#components[@]}"
}

function path_stem_at_depth {
    local canonical_path="$1"
    local depth="$2"
    local base_name="${canonical_path##*/}"
    local parent_path=""
    local prefix=""
    local component=""
    local start=0
    local index=0
    local -a components=()

    if [[ -z "$base_name" ]]; then
        base_name="root"
    fi
    parent_path="${canonical_path%/*}"
    parent_path="${parent_path#/}"
    if [[ -n "$parent_path" ]]; then
        IFS='/' read -r -a components <<< "$parent_path"
    fi
    start=$((${#components[@]} - depth))
    if (( start < 0 )); then
        start=0
    fi
    for ((index = start; index < ${#components[@]}; index++)); do
        component="${components[$index]}"
        if [[ -n "$prefix" ]]; then
            prefix="${prefix}-${component}"
        else
            prefix="$component"
        fi
    done
    if [[ -n "$prefix" ]]; then
        printf '%s-%s\n' "$prefix" "$base_name"
    else
        printf '%s\n' "$base_name"
    fi
}

function normalized_base_name {
    local canonical_path="$1"
    local base_name="${canonical_path##*/}"

    if [[ -z "$base_name" ]]; then
        base_name="root"
    fi
    normalize_session_name "$base_name"
}

function candidate_distinguishes_path {
    local canonical_path="$1"
    local depth="$2"
    local current_base=""
    local current_stem=""
    local other_base=""
    local other_stem=""
    local other_path=""

    current_base=$(normalized_base_name "$canonical_path")
    current_stem=$(path_stem_at_depth "$canonical_path" "$depth")
    current_stem=$(normalize_session_name "$current_stem")
    for other_path in "${MANAGED_SESSION_PATHS[@]}"; do
        if [[ "$other_path" == "$canonical_path" ]]; then
            continue
        fi
        other_base=$(normalized_base_name "$other_path")
        if [[ "$other_base" != "$current_base" ]]; then
            continue
        fi
        other_stem=$(path_stem_at_depth "$other_path" "$depth")
        other_stem=$(normalize_session_name "$other_stem")
        if [[ "$other_stem" == "$current_stem" ]]; then
            return 1
        fi
    done
    return 0
}

function max_collision_depth {
    local canonical_path="$1"
    local current_base=""
    local other_base=""
    local other_depth=0
    local maximum=0
    local other_path=""

    current_base=$(normalized_base_name "$canonical_path")
    maximum=$(path_parent_count "$canonical_path")
    for other_path in "${MANAGED_SESSION_PATHS[@]}"; do
        other_base=$(normalized_base_name "$other_path")
        if [[ "$other_base" != "$current_base" ]]; then
            continue
        fi
        other_depth=$(path_parent_count "$other_path")
        if (( other_depth > maximum )); then
            maximum=$other_depth
        fi
    done
    printf '%d\n' "$maximum"
}

function has_same_base_collision {
    local canonical_path="$1"
    local current_base=""
    local other_base=""
    local other_path=""

    current_base=$(normalized_base_name "$canonical_path")
    for other_path in "${MANAGED_SESSION_PATHS[@]}"; do
        if [[ "$other_path" == "$canonical_path" ]]; then
            continue
        fi
        other_base=$(normalized_base_name "$other_path")
        if [[ "$other_base" == "$current_base" ]]; then
            return 0
        fi
    done
    return 1
}

function runner_repos_file {
    local config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"

    printf '%s/tmux-runner/repos\n' "$config_home"
}

function report_repos_setup_error {
    local message="$1"
    local repos_file="$2"

    fail "$message: $repos_file"
    printf 'Add one literal absolute search root per line.\n' >&2
    return 2
}

function warn_repository_root {
    local message="$1"
    local root_path="$2"

    printf '%s: warning: %s: %s\n' \
        "$PROGRAM_NAME" "$message" "$root_path" >&2
}

function load_repository_roots {
    local required="$1"
    local repos_file=""
    local line=""
    local canonical_root=""
    local -A seen_roots=()

    REPOSITORY_ROOTS=()
    repos_file=$(runner_repos_file)
    if [[ ! -e "$repos_file" ]]; then
        if (( required )); then
            report_repos_setup_error "repository root file is missing" \
                "$repos_file"
            return
        fi
        return 1
    fi
    if [[ ! -f "$repos_file" ]] || [[ ! -r "$repos_file" ]]; then
        report_repos_setup_error "repository root file is not readable" \
            "$repos_file"
        return
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        if [[ "$line" =~ ^[[:space:]]*$ ]] || \
            [[ "$line" =~ ^[[:space:]]*# ]]; then
            continue
        fi
        if [[ "$line" != /* ]]; then
            warn_repository_root "repository root is not absolute" "$line"
            continue
        fi
        if [[ ! -d "$line" ]]; then
            warn_repository_root "repository root is missing" "$line"
            continue
        fi
        if [[ ! -r "$line" ]] || [[ ! -x "$line" ]]; then
            warn_repository_root "repository root is not accessible" "$line"
            continue
        fi
        if ! canonical_root=$(cd -- "$line" 2>/dev/null && pwd -P); then
            warn_repository_root "repository root is not accessible" "$line"
            continue
        fi
        if [[ -z "${seen_roots[$canonical_root]+present}" ]]; then
            seen_roots["$canonical_root"]=1
            REPOSITORY_ROOTS+=("$canonical_root")
        fi
    done < "$repos_file"

    if (( ${#REPOSITORY_ROOTS[@]} == 0 )); then
        if (( required )); then
            report_repos_setup_error "repository root file has no usable roots" \
                "$repos_file"
            return
        fi
        return 1
    fi
}

function is_git_worktree_path {
    local candidate_path="$1"
    local inside_work_tree=""
    local bare_repository=""
    local git_top=""
    local physical_top=""

    inside_work_tree=$("$GIT_BIN" -C "$candidate_path" rev-parse \
        --is-inside-work-tree 2>/dev/null) || return 1
    [[ "$inside_work_tree" == "true" ]] || return 1
    bare_repository=$("$GIT_BIN" -C "$candidate_path" rev-parse \
        --is-bare-repository 2>/dev/null) || return 1
    [[ "$bare_repository" == "false" ]] || return 1
    git_top=$("$GIT_BIN" -C "$candidate_path" rev-parse --show-toplevel \
        2>/dev/null) || return 1
    physical_top=$(cd -- "$git_top" 2>/dev/null && pwd -P) || return 1
    [[ "$physical_top" == "$candidate_path" ]]
}

function classify_path_identity {
    local candidate_path="$1"
    local physical_path=""
    local inside_work_tree="false"

    PATH_IDENTITY_KIND=""
    if [[ -z "$GIT_BIN" ]] || [[ ! -x "$GIT_BIN" ]]; then
        return 2
    fi
    if ! physical_path=$(cd -- "$candidate_path" 2>/dev/null && pwd -P) || \
        [[ "$physical_path" != "$candidate_path" ]]; then
        return 1
    fi
    inside_work_tree=$(
        "$GIT_BIN" -C "$candidate_path" rev-parse --is-inside-work-tree \
            2>/dev/null || printf 'false\n'
    )
    if [[ "$inside_work_tree" == "true" ]] && \
        is_git_worktree_path "$candidate_path"; then
        PATH_IDENTITY_KIND="git"
    elif [[ "$inside_work_tree" == "true" ]]; then
        return 1
    else
        PATH_IDENTITY_KIND="plain"
    fi
}

function path_matches_identity_kind {
    local candidate_path="$1"
    local expected_kind="$2"

    classify_path_identity "$candidate_path" || return
    [[ "$PATH_IDENTITY_KIND" == "$expected_kind" ]]
}

function discover_repository_catalog {
    local required="$1"
    local repos_file=""
    local root_path=""
    local marker_path=""
    local candidate_path=""
    local -a markers=()
    local -A seen_paths=()

    CATALOG_PATHS=()
    for root_path in "${REPOSITORY_ROOTS[@]}"; do
        markers=()
        while IFS= read -r -d '' marker_path; do
            markers+=("$marker_path")
        done < <(
            "$FIND_BIN" -P "$root_path" \
                \( -type d -name .git -print0 -prune \) -o \
                \( -type f -name .git -print0 \)
        )
        for marker_path in "${markers[@]}"; do
            candidate_path="${marker_path%/.git}"
            if ! candidate_path=$(cd -- "$candidate_path" 2>/dev/null && \
                pwd -P); then
                continue
            fi
            if [[ "$candidate_path" == *$'\n'* ]]; then
                state_encode_field "$candidate_path"
                warn_repository_root \
                    "repository path contains a newline" "$STATE_ENCODED"
                continue
            fi
            if is_git_worktree_path "$candidate_path" && \
                [[ -z "${seen_paths[$candidate_path]+present}" ]]; then
                seen_paths["$candidate_path"]=1
                CATALOG_PATHS+=("$candidate_path")
            fi
        done
    done

    if (( ${#CATALOG_PATHS[@]} > 0 )); then
        mapfile -t CATALOG_PATHS < <(
            printf '%s\n' "${CATALOG_PATHS[@]}" | \
                LC_ALL=C "$SORT_BIN" -u
        )
        return 0
    fi
    if (( required )); then
        repos_file=$(runner_repos_file)
        fail "no Git working trees found under roots in: $repos_file"
        return
    fi
    return 1
}

function catalog_labels_have_duplicate {
    local first_index=0
    local second_index=0

    CATALOG_DUPLICATES=()
    for first_index in "${!CATALOG_PATHS[@]}"; do
        CATALOG_DUPLICATES+=(0)
    done
    for first_index in "${!CATALOG_LABELS[@]}"; do
        for ((second_index = first_index + 1; \
            second_index < ${#CATALOG_LABELS[@]}; second_index++)); do
            if [[ "${CATALOG_LABELS[$first_index]}" == \
                "${CATALOG_LABELS[$second_index]}" ]]; then
                CATALOG_DUPLICATES[first_index]=1
                CATALOG_DUPLICATES[second_index]=1
            fi
        done
    done
    for first_index in "${!CATALOG_DUPLICATES[@]}"; do
        if (( CATALOG_DUPLICATES[first_index] )); then
            return 0
        fi
    done
    return 1
}

function catalog_label_is_used {
    local candidate_label="$1"
    local current_index="$2"
    local index=0

    for index in "${!CATALOG_LABELS[@]}"; do
        if (( index == current_index )); then
            continue
        fi
        if [[ "${CATALOG_LABELS[$index]}" == "$candidate_label" ]]; then
            return 0
        fi
    done
    return 1
}

function build_catalog_labels {
    local index=0
    local parent_count=0
    local made_progress=0
    local stem=""
    local hash_output=""
    local path_hash=""
    local candidate_label=""
    local hash_length=12

    CATALOG_LABELS=()
    CATALOG_DEPTHS=()
    for index in "${!CATALOG_PATHS[@]}"; do
        CATALOG_LABELS+=("")
        CATALOG_DEPTHS+=(0)
    done

    while true; do
        for index in "${!CATALOG_PATHS[@]}"; do
            stem=$(path_stem_at_depth "${CATALOG_PATHS[$index]}" \
                "${CATALOG_DEPTHS[$index]}")
            CATALOG_LABELS[index]=$(normalize_session_name "$stem")
        done
        if ! catalog_labels_have_duplicate; then
            return 0
        fi
        made_progress=0
        for index in "${!CATALOG_PATHS[@]}"; do
            if (( ! CATALOG_DUPLICATES[index] )); then
                continue
            fi
            parent_count=$(path_parent_count "${CATALOG_PATHS[$index]}")
            if (( CATALOG_DEPTHS[index] < parent_count )); then
                CATALOG_DEPTHS[index]=$((CATALOG_DEPTHS[index] + 1))
                made_progress=1
            fi
        done
        if (( ! made_progress )); then
            break
        fi
    done

    if [[ -z "$SHA256_BIN" ]] || [[ ! -x "$SHA256_BIN" ]]; then
        fail "sha256sum is required to resolve repository-label collisions"
        return
    fi
    for index in "${!CATALOG_PATHS[@]}"; do
        if (( ! CATALOG_DUPLICATES[index] )); then
            continue
        fi
        hash_output=$(printf '%s' "${CATALOG_PATHS[$index]}" | \
            "$SHA256_BIN")
        path_hash="${hash_output%% *}"
        for ((hash_length = 12; hash_length <= 64; hash_length++)); do
            candidate_label="${CATALOG_LABELS[$index]}-${path_hash:0:hash_length}"
            if ! catalog_label_is_used "$candidate_label" "$index"; then
                CATALOG_LABELS[index]="$candidate_label"
                break
            fi
        done
        if catalog_label_is_used "${CATALOG_LABELS[$index]}" "$index"; then
            fail "no unique repository label is available for path: ${CATALOG_PATHS[$index]}"
            return
        fi
    done
}

function load_repository_catalog {
    local required="$1"
    local load_rc=0

    load_repository_roots "$required" || load_rc=$?
    if (( load_rc != 0 )); then
        return "$load_rc"
    fi
    if [[ -z "$GIT_BIN" ]] || [[ ! -x "$GIT_BIN" ]]; then
        fail "git is not available in PATH"
        return
    fi
    if [[ -z "$FIND_BIN" ]] || [[ ! -x "$FIND_BIN" ]]; then
        fail "find is not available in PATH"
        return
    fi
    if [[ -z "$SORT_BIN" ]] || [[ ! -x "$SORT_BIN" ]]; then
        fail "sort is not available in PATH"
        return
    fi
    discover_repository_catalog "$required" || load_rc=$?
    if (( load_rc != 0 )); then
        return "$load_rc"
    fi
    build_catalog_labels
}

function catalog_label_for_path {
    local canonical_path="$1"
    local index=0

    for index in "${!CATALOG_PATHS[@]}"; do
        if [[ "${CATALOG_PATHS[$index]}" == "$canonical_path" ]]; then
            printf '%s\n' "${CATALOG_LABELS[$index]}"
            return 0
        fi
    done
    return 1
}

function connect_auto_path {
    local canonical_path="$1"
    local candidate_name="$2"
    local expected_kind="$3"

    load_managed_sessions
    find_path_matches "$canonical_path"
    if (( ${#PATH_MATCHES[@]} > 1 )); then
        discard_state_event || true
        report_ambiguous_path "$canonical_path"
        return
    fi
    if (( ${#PATH_MATCHES[@]} == 1 )); then
        connect_verified_path "${PATH_MATCHES[0]}" "$canonical_path" \
            "$expected_kind"
    else
        if ! load_session_path_option "$candidate_name" || \
            [[ "$SESSION_PATH_VALUE" != "$canonical_path" ]]; then
            discard_state_event || true
            fail "session identity changed before attachment: $candidate_name"
            return
        fi
        connect_session "$candidate_name" "$canonical_path" \
            "$expected_kind"
    fi
}

function enter_explicit_path {
    local session_name="$1"
    local canonical_path="$2"
    local expected_kind="$3"
    local attempt_rc=0

    try_marked_session "$session_name" "$canonical_path" "$expected_kind" || \
        attempt_rc=$?
    if (( attempt_rc == 0 )); then
        connect_verified_path "$session_name" "$canonical_path" \
            "$expected_kind"
        return
    fi
    if (( attempt_rc == 3 )); then
        report_explicit_conflict "$session_name" "$canonical_path"
        return
    fi
    return "$attempt_rc"
}

function enter_automatic_path {
    local canonical_path="$1"
    local short_hostname="$2"
    local expected_kind="$3"
    local stem=""
    local candidate_name=""
    local previous_candidate=""
    local hash_output=""
    local path_hash=""
    local depth=0
    local start_depth=0
    local maximum_depth=0
    local hash_length=12
    local attempt_rc=0

    load_managed_sessions
    find_path_matches "$canonical_path"
    if (( ${#PATH_MATCHES[@]} > 1 )); then
        report_ambiguous_path "$canonical_path"
        return
    fi
    if (( ${#PATH_MATCHES[@]} == 1 )); then
        connect_verified_path "${PATH_MATCHES[0]}" "$canonical_path" \
            "$expected_kind"
        return
    fi

    if has_same_base_collision "$canonical_path"; then
        start_depth=1
    fi
    maximum_depth=$(max_collision_depth "$canonical_path")
    for ((depth = start_depth; depth <= maximum_depth; depth++)); do
        if ! candidate_distinguishes_path "$canonical_path" "$depth"; then
            continue
        fi
        stem=$(path_stem_at_depth "$canonical_path" "$depth")
        candidate_name=$(normalize_session_name "${stem}-${short_hostname}")
        if [[ "$candidate_name" == "$previous_candidate" ]]; then
            continue
        fi
        previous_candidate="$candidate_name"
        attempt_rc=0
        try_marked_session "$candidate_name" "$canonical_path" \
            "$expected_kind" || \
            attempt_rc=$?
        if (( attempt_rc == 0 )); then
            connect_auto_path "$canonical_path" "$candidate_name" \
                "$expected_kind"
            return
        fi
        if (( attempt_rc != 3 )); then
            return "$attempt_rc"
        fi
        load_managed_sessions
    done

    if [[ -z "$SHA256_BIN" ]] || [[ ! -x "$SHA256_BIN" ]]; then
        fail "sha256sum is required to resolve this session-name collision"
        return
    fi
    stem=$(path_stem_at_depth "$canonical_path" \
        "$(path_parent_count "$canonical_path")")
    hash_output=$(printf '%s' "$canonical_path" | "$SHA256_BIN")
    path_hash="${hash_output%% *}"
    for ((hash_length = 12; hash_length <= 64; hash_length++)); do
        candidate_name=$(normalize_session_name \
            "${stem}-${path_hash:0:hash_length}-${short_hostname}")
        attempt_rc=0
        try_marked_session "$candidate_name" "$canonical_path" \
            "$expected_kind" || \
            attempt_rc=$?
        if (( attempt_rc == 0 )); then
            connect_auto_path "$canonical_path" "$candidate_name" \
                "$expected_kind"
            return
        fi
        if (( attempt_rc != 3 )); then
            return "$attempt_rc"
        fi
    done
    fail "no unique session name is available for path: $canonical_path"
}

function enter_catalog_path {
    local canonical_path="$1"
    local catalog_label="$2"
    local short_hostname="$3"
    local expected_kind="$4"
    local candidate_name=""
    local hash_output=""
    local path_hash=""
    local hash_length=12
    local attempt_rc=0

    load_managed_sessions
    find_path_matches "$canonical_path"
    if (( ${#PATH_MATCHES[@]} > 1 )); then
        report_ambiguous_path "$canonical_path"
        return
    fi
    if (( ${#PATH_MATCHES[@]} == 1 )); then
        connect_verified_path "${PATH_MATCHES[0]}" "$canonical_path" \
            "$expected_kind"
        return
    fi

    candidate_name=$(normalize_session_name \
        "${catalog_label}-${short_hostname}")
    try_marked_session "$candidate_name" "$canonical_path" "$expected_kind" || \
        attempt_rc=$?
    if (( attempt_rc == 0 )); then
        connect_auto_path "$canonical_path" "$candidate_name" \
            "$expected_kind"
        return
    fi
    if (( attempt_rc != 3 )); then
        return "$attempt_rc"
    fi

    if [[ -z "$SHA256_BIN" ]] || [[ ! -x "$SHA256_BIN" ]]; then
        fail "sha256sum is required to resolve this catalog session-name collision"
        return
    fi
    hash_output=$(printf '%s' "$canonical_path" | "$SHA256_BIN")
    path_hash="${hash_output%% *}"
    for ((hash_length = 12; hash_length <= 64; hash_length++)); do
        candidate_name=$(normalize_session_name \
            "${catalog_label}-${path_hash:0:hash_length}-${short_hostname}")
        attempt_rc=0
        try_marked_session "$candidate_name" "$canonical_path" \
            "$expected_kind" || \
            attempt_rc=$?
        if (( attempt_rc == 0 )); then
            connect_auto_path "$canonical_path" "$candidate_name" \
                "$expected_kind"
            return
        fi
        if (( attempt_rc != 3 )); then
            return "$attempt_rc"
        fi
    done
    fail "no unique catalog session name is available for path: $canonical_path"
}

function revalidate_catalog_path {
    local selected_path="$1"
    local physical_path=""

    if ! physical_path=$(cd -- "$selected_path" 2>/dev/null && pwd -P); then
        fail "selected repository is no longer accessible: $selected_path"
        return
    fi
    if [[ "$physical_path" != "$selected_path" ]]; then
        fail "selected repository path changed after listing: $selected_path"
        return
    fi
    if ! is_git_worktree_path "$selected_path"; then
        fail "selected path is no longer a Git working tree: $selected_path"
        return
    fi
}

function runner_config_file {
    local config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"

    printf '%s/tmux-runner/tmux.conf\n' "$config_home"
}

function runner_socket_path {
    local socket_root="${TMUX_TMPDIR:-/tmp}"

    socket_root="${socket_root%/}"
    printf '%s/tmux-%s/%s\n' "$socket_root" "$UID" "$TMUX_SERVER_NAME"
}

function validate_client_server {
    local current_socket=""
    local expected_socket=""

    if [[ -z "${TMUX:-}" ]]; then
        return 0
    fi
    current_socket="${TMUX%%,*}"
    expected_socket=$(runner_socket_path)
    if [[ "$current_socket" != "$expected_socket" ]]; then
        fail "current tmux client uses another server; detach and rerun tmux-runner from the outer shell"
        return
    fi
}

function run_tmux_command {
    local config_file=""

    config_file=$(runner_config_file)
    if [[ ! -e "$config_file" ]]; then
        config_file="/dev/null"
    fi
    (
        if [[ -n "$STATE_LOCK_FD" ]]; then
            exec {STATE_LOCK_FD}>&-
        fi
        if [[ -n "$STATE_EVENT_FD" ]]; then
            exec {STATE_EVENT_FD}>&-
        fi
        "$TMUX_BIN" -L "$TMUX_SERVER_NAME" -f "$config_file" "$@"
    )
}

function run_tmux_command_without_state_fds {
    run_tmux_command "$@"
}

function run_session_entry_hook {
    if [[ -z "$SESSION_ENTRY_HOOK_NAME" ]] || \
        [[ -z "$SESSION_ENTRY_HOOK_COMMAND" ]] || \
        [[ -z "$SESSION_ENTRY_HOOK_TARGET" ]]; then
        fail "session entry hook is not prepared"
        return 1
    fi
    run_tmux_command_without_state_fds set-hook \
        -t "$SESSION_ENTRY_HOOK_TARGET" "$SESSION_ENTRY_HOOK_NAME" \
        "$SESSION_ENTRY_HOOK_COMMAND" \; \
        set-hook -R -t "$SESSION_ENTRY_HOOK_TARGET" \
        "$SESSION_ENTRY_HOOK_NAME" \; \
        set-hook -u -t "$SESSION_ENTRY_HOOK_TARGET" \
        "$SESSION_ENTRY_HOOK_NAME"
}

function connect_inside_session {
    local session_id="$1"
    local selected_name="$2"
    local raw_marker="$3"
    local marker_present="$4"
    local expected_path="${5:-}"
    local expected_kind="${6:-}"
    local tmux_rc=0
    local state_rc=0
    local acknowledged=0

    if [[ -n "$expected_path" ]] && \
        ! revalidate_entry_path "$expected_path" "$expected_kind"; then
        discard_state_event || true
        return 1
    fi
    if ! prepare_session_entry switch-client "$session_id" \
            "$selected_name" "$raw_marker" "$marker_present"; then
        discard_state_event || true
        return 1
    fi
    run_session_entry_hook || tmux_rc=$?
    if (( tmux_rc == 0 )) && [[ -f "$STATE_ACK_FILE" ]] && \
        [[ ! -L "$STATE_ACK_FILE" ]]; then
        acknowledged=1
    fi
    if (( acknowledged )); then
        settle_state_event 1 || state_rc=$?
    else
        settle_state_event 0 || state_rc=$?
    fi
    if (( state_rc != 0 )); then
        if (( tmux_rc == 0 )) && [[ -f "$STATE_ACK_FILE" ]]; then
            clear_state_event
            return 0
        fi
        clear_state_event
        return "$state_rc"
    fi
    if (( ! acknowledged && tmux_rc == 0 )); then
        printf '%s: session entry was not acknowledged: %s\n' \
            "$PROGRAM_NAME" "$selected_name" >&2
        return 1
    fi
    return "$tmux_rc"
}

function connect_outside_session {
    local session_id="$1"
    local selected_name="$2"
    local raw_marker="$3"
    local marker_present="$4"
    local expected_path="${5:-}"
    local expected_kind="${6:-}"
    local terminal_fd=""
    local attach_pid=""
    local attach_rc=0
    local state_rc=0
    local settled=0
    local acknowledged=0
    local event_lock_released=0
    local ack_file="$STATE_ACK_FILE"
    local ack_deadline=0

    if ! exec {terminal_fd}<&0; then
        settle_state_event 0 || state_rc=$?
        if (( state_rc != 0 )); then
            clear_state_event
        fi
        fail "cannot duplicate terminal input for attachment"
        return
    fi
    if [[ -n "$expected_path" ]] && \
        ! revalidate_entry_path "$expected_path" "$expected_kind"; then
        exec {terminal_fd}>&-
        discard_state_event || true
        return 1
    fi
    if ! prepare_session_entry attach-session "$session_id" \
            "$selected_name" "$raw_marker" "$marker_present"; then
        exec {terminal_fd}>&-
        discard_state_event || true
        return 1
    fi
    (
        exec 0<&"$terminal_fd"
        exec {terminal_fd}>&-
        if [[ -n "$STATE_LOCK_FD" ]]; then
            exec {STATE_LOCK_FD}>&-
        fi
        if [[ -n "$STATE_EVENT_FD" ]]; then
            exec {STATE_EVENT_FD}>&-
        fi
        run_session_entry_hook
    ) &
    attach_pid=$!
    exec {terminal_fd}>&-

    while true; do
        if [[ -f "$ack_file" ]] && [[ ! -L "$ack_file" ]]; then
            acknowledged=1
            break
        fi
        if ! kill -0 "$attach_pid" 2>/dev/null; then
            break
        fi
        "$SLEEP_BIN" 0.02
    done
    if (( acknowledged )); then
        if settle_state_event 1; then
            settled=1
        else
            state_rc=$?
            release_state_event_lock
            event_lock_released=1
        fi
    fi

    while (( acknowledged && ! settled && event_lock_released )) && \
        kill -0 "$attach_pid" 2>/dev/null; do
        if recover_released_state_event; then
            settled=1
            break
        fi
        "$SLEEP_BIN" 0.05
    done

    wait "$attach_pid" || attach_rc=$?
    if (( ! acknowledged && attach_rc == 0 )); then
        ack_deadline=$((SECONDS + STATE_ACK_WAIT_TIMEOUT))
        while (( SECONDS <= ack_deadline )); do
            if [[ -f "$ack_file" ]] && [[ ! -L "$ack_file" ]]; then
                acknowledged=1
                break
            fi
            "$SLEEP_BIN" 0.02
        done
    fi
    if (( ! settled )); then
        if (( ! acknowledged )); then
            if [[ -f "$ack_file" ]] && [[ ! -L "$ack_file" ]]; then
                acknowledged=1
            fi
        fi
        state_rc=0
        if (( event_lock_released )); then
            if recover_released_state_event; then
                settled=1
            else
                state_rc=0
                clear_state_event
                settled=1
            fi
        elif settle_state_event "$acknowledged"; then
            settled=1
        else
            state_rc=$?
        fi
    fi
    if (( ! settled )); then
        clear_state_event
        return "$state_rc"
    fi
    if (( ! acknowledged && attach_rc == 0 )); then
        printf '%s: session entry was not acknowledged: %s\n' \
            "$PROGRAM_NAME" "$selected_name" >&2
        return 1
    fi
    return "$attach_rc"
}

function connect_session {
    local session_name="$1"
    local expected_path="${2:-}"
    local expected_kind="${3:-}"
    local session_path=""
    local session_id=""
    local selected_name=""
    local raw_marker=""
    local marker_present=0
    local server_identity=""
    local path_kind=""
    local resolve_rc=0

    resolve_session_target "$session_name" || resolve_rc=$?
    if (( resolve_rc != 0 )); then
        discard_state_event || true
        return "$resolve_rc"
    fi
    session_id="$SESSION_TARGET_ID"
    selected_name="$SESSION_TARGET_NAME"
    raw_marker="$SESSION_PATH_MARKER"
    marker_present=$SESSION_PATH_MARKER_PRESENT
    if (( marker_present )); then
        session_path="$SESSION_PATH_VALUE"
    fi
    server_identity=$(runner_socket_path)
    if [[ -n "$expected_path" ]]; then
        if [[ "$session_path" != "$expected_path" ]]; then
            discard_state_event || true
            fail "session identity changed before attachment: $session_name"
            return 1
        fi
        path_kind="$expected_kind"
    elif [[ -n "$session_path" ]] && \
        classify_path_identity "$session_path"; then
        path_kind="$PATH_IDENTITY_KIND"
    fi
    if [[ -n "$STATE_TRANSACTION_ID" ]] && \
        { [[ "$STATE_EVENT_SERVER" != "$server_identity" ]] || \
            [[ "$STATE_EVENT_SESSION_NAME" != "$session_name" ]] || \
            [[ "$STATE_EVENT_SESSION_PATH" != "$session_path" ]] || \
            [[ "$STATE_EVENT_PATH_KIND" != "$path_kind" ]]; }; then
        discard_state_event || return
    fi
    if [[ -z "$STATE_TRANSACTION_ID" ]]; then
        stage_state_event "$selected_name" "$session_path" "$path_kind" || \
            return
    fi
    if ! build_state_ack_command "$session_id"; then
        discard_state_event || true
        return 1
    fi

    if [[ -n "${TMUX:-}" ]]; then
        connect_inside_session "$session_id" "$selected_name" \
            "$raw_marker" "$marker_present" "$expected_path" \
            "$expected_kind"
    else
        connect_outside_session "$session_id" "$selected_name" \
            "$raw_marker" "$marker_present" "$expected_path" \
            "$expected_kind"
    fi
}

function run_create {
    local command_name="$1"
    local session_name=""
    local directory=""
    local resolved_directory=""
    local canonical_path=""
    local path_kind=""
    local catalog_label=""
    local catalog_rc=0
    local short_hostname=""
    local saw_session=0
    local saw_directory=0

    shift
    while (( $# > 0 )); do
        case "$1" in
            -s)
                if (( saw_session )) || (( $# < 2 )) || [[ -z "$2" ]]; then
                    fail_create_usage "$command_name" \
                        "-s requires one session name and may appear only once"
                    return
                fi
                session_name="$2"
                saw_session=1
                shift 2
                ;;
            -c)
                if (( saw_directory )) || (( $# < 2 )) || [[ -z "$2" ]]; then
                    fail_create_usage "$command_name" \
                        "-c requires one folder and may appear only once"
                    return
                fi
                directory="$2"
                saw_directory=1
                shift 2
                ;;
            --)
                shift
                break
                ;;
            -*)
                fail_create_usage "$command_name" "unknown option: $1"
                return
                ;;
            *)
                fail_create_usage "$command_name" "unexpected argument: $1"
                return
                ;;
        esac
    done

    if (( $# > 0 )); then
        fail_create_usage "$command_name" "unexpected argument: $1"
        return
    fi

    if [[ -z "$directory" ]]; then
        directory="$PWD"
    fi
    if ! resolved_directory=$(cd -- "$directory" 2>/dev/null && pwd -P); then
        fail_create_usage "$command_name" "folder does not exist: $directory"
        return
    fi
    canonical_path=$(resolve_working_path "$resolved_directory") || return
    if ! classify_path_identity "$canonical_path"; then
        fail "folder identity changed before session entry: $canonical_path"
        return
    fi
    path_kind="$PATH_IDENTITY_KIND"

    if (( saw_session )); then
        session_name=$(normalize_session_name "$session_name")
        if [[ -z "$session_name" ]]; then
            fail_create_usage "$command_name" "session name must not be empty"
            return
        fi
        initialize_state_runtime || return
        enter_explicit_path "$session_name" "$canonical_path" "$path_kind"
        return
    fi

    if [[ -z "$HOSTNAME_BIN" ]] || [[ ! -x "$HOSTNAME_BIN" ]]; then
        fail "hostname is not available in PATH"
        return
    fi
    short_hostname=$("$HOSTNAME_BIN" -s)
    initialize_state_runtime || return
    load_repository_catalog 0 || catalog_rc=$?
    if (( catalog_rc == 0 )) && \
        catalog_label=$(catalog_label_for_path "$canonical_path"); then
        enter_catalog_path "$canonical_path" "$catalog_label" \
            "$short_hostname" "$path_kind"
        return
    fi
    if (( catalog_rc != 0 && catalog_rc != 1 )); then
        return "$catalog_rc"
    fi
    enter_automatic_path "$canonical_path" "$short_hostname" "$path_kind"
}

function run_repo {
    local selection=""
    local selected_index=-1
    local selected_path=""
    local selected_label=""
    local short_hostname=""
    local index=0

    if (( $# > 0 )); then
        fail "repo does not accept arguments"
        return
    fi
    load_repository_catalog 1 || return

    for index in "${!CATALOG_PATHS[@]}"; do
        printf '%d %s  %s\n' "$((index + 1))" \
            "${CATALOG_LABELS[$index]}" "${CATALOG_PATHS[$index]}"
    done
    printf 'Select repository: '
    if ! IFS= read -r selection; then
        printf '\n' >&2
        fail "no repository selection received"
        return
    fi
    if [[ ! "$selection" =~ ^[0-9]+$ ]]; then
        fail "repository selection must be a number"
        return
    fi
    while [[ "${#selection}" -gt 1 ]] && \
        [[ "${selection:0:1}" == "0" ]]; do
        selection="${selection:1}"
    done
    for index in "${!CATALOG_PATHS[@]}"; do
        if [[ "$selection" == "$((index + 1))" ]]; then
            selected_index=$index
            break
        fi
    done
    if (( selected_index < 0 )); then
        fail "repository selection is outside the displayed range"
        return
    fi
    selected_path="${CATALOG_PATHS[$selected_index]}"
    selected_label="${CATALOG_LABELS[$selected_index]}"
    revalidate_catalog_path "$selected_path" || return
    if [[ -z "$HOSTNAME_BIN" ]] || [[ ! -x "$HOSTNAME_BIN" ]]; then
        fail "hostname is not available in PATH"
        return
    fi
    short_hostname=$("$HOSTNAME_BIN" -s)
    initialize_state_runtime || return
    enter_catalog_path "$selected_path" "$selected_label" "$short_hostname" \
        git
}

function run_recent {
    local selection=""
    local selected_index=-1
    local selected_path=""
    local selected_kind=""
    local physical_path=""
    local catalog_label=""
    local catalog_rc=0
    local short_hostname=""
    local index=0
    local -a valid_kinds=()
    local -a valid_paths=()

    if (( $# > 0 )); then
        fail "recent does not accept arguments"
        return
    fi
    initialize_state_runtime || return
    if [[ -z "$GIT_BIN" ]] || [[ ! -x "$GIT_BIN" ]]; then
        fail "git is not available in PATH"
        return
    fi
    for index in "${!STATE_RECENT_PATHS[@]}"; do
        selected_path="${STATE_RECENT_PATHS[$index]}"
        selected_kind="${STATE_RECENT_KINDS[$index]}"
        if path_matches_identity_kind "$selected_path" "$selected_kind"; then
            valid_paths+=("$selected_path")
            valid_kinds+=("$selected_kind")
        fi
    done
    if (( ${#valid_paths[@]} == 0 )); then
        fail "no recent destinations are available"
        return
    fi

    for index in "${!valid_paths[@]}"; do
        state_encode_field "${valid_paths[$index]}"
        printf '%d %s\n' "$((index + 1))" "$STATE_ENCODED"
    done
    printf 'Select recent destination: '
    if ! IFS= read -r selection; then
        printf '\n' >&2
        fail "no recent selection received"
        return
    fi
    if [[ ! "$selection" =~ ^[0-9]+$ ]]; then
        fail "recent selection must be a number"
        return
    fi
    while [[ "${#selection}" -gt 1 ]] && \
        [[ "${selection:0:1}" == "0" ]]; do
        selection="${selection:1}"
    done
    for index in "${!valid_paths[@]}"; do
        if [[ "$selection" == "$((index + 1))" ]]; then
            selected_index=$index
            break
        fi
    done
    if (( selected_index < 0 )); then
        fail "recent selection is outside the displayed range"
        return
    fi
    selected_path="${valid_paths[$selected_index]}"
    selected_kind="${valid_kinds[$selected_index]}"
    if ! physical_path=$(cd -- "$selected_path" 2>/dev/null && pwd -P) || \
        [[ "$physical_path" != "$selected_path" ]]; then
        fail "recent destination is no longer accessible: $selected_path"
        return
    fi
    if ! classify_path_identity "$selected_path"; then
        fail "recent destination identity changed: $selected_path"
        return
    fi
    if [[ "$PATH_IDENTITY_KIND" != "$selected_kind" ]]; then
        fail "recent destination kind changed: $selected_path"
        return
    fi
    if [[ -z "$HOSTNAME_BIN" ]] || [[ ! -x "$HOSTNAME_BIN" ]]; then
        fail "hostname is not available in PATH"
        return
    fi
    short_hostname=$("$HOSTNAME_BIN" -s)
    load_repository_catalog 0 || catalog_rc=$?
    if (( catalog_rc == 0 )) && \
        catalog_label=$(catalog_label_for_path "$selected_path"); then
        enter_catalog_path "$selected_path" "$catalog_label" \
            "$short_hostname" "$selected_kind"
        return
    fi
    if (( catalog_rc != 0 && catalog_rc != 1 )); then
        return "$catalog_rc"
    fi
    enter_automatic_path "$selected_path" "$short_hostname" \
        "$selected_kind"
}

function run_last {
    local target_session=""
    local server_identity=""
    local index=0
    local -a server_sessions=()

    if (( $# > 0 )); then
        fail "last does not accept arguments"
        return
    fi
    initialize_state_runtime || return
    server_identity=$(runner_socket_path)
    for index in "${!STATE_SESSION_NAMES[@]}"; do
        if [[ "${STATE_SESSION_SERVERS[$index]}" == "$server_identity" ]]; then
            server_sessions+=("${STATE_SESSION_NAMES[$index]}")
        fi
    done
    if (( ${#server_sessions[@]} < 2 )); then
        fail "no previous runner session is available"
        return
    fi
    target_session="${server_sessions[1]}"
    if ! run_tmux_command has-session -t "=$target_session" 2>/dev/null; then
        fail "previous runner session no longer exists: $target_session"
        return
    fi
    connect_session "$target_session"
}

function run_attach {
    local command_name="$1"
    local session_name=""
    local saw_target=0

    shift
    while (( $# > 0 )); do
        case "$1" in
            -t)
                if (( saw_target )) || [[ -n "$session_name" ]] || \
                    (( $# < 2 )) || [[ -z "$2" ]]; then
                    fail_attach_usage "$command_name" \
                        "provide exactly one session target"
                    return
                fi
                session_name="$2"
                saw_target=1
                shift 2
                ;;
            --)
                if [[ -n "$session_name" ]] || (( $# != 2 )) || \
                    [[ -z "$2" ]]; then
                    fail_attach_usage "$command_name" \
                        "provide exactly one session target"
                    return
                fi
                session_name="$2"
                saw_target=1
                shift 2
                break
                ;;
            -*)
                fail_attach_usage "$command_name" "unknown option: $1"
                return
                ;;
            *)
                if [[ -n "$session_name" ]]; then
                    fail_attach_usage "$command_name" \
                        "provide exactly one session target"
                    return
                fi
                session_name="$1"
                shift
                ;;
        esac
    done

    if (( $# > 0 )) || [[ -z "$session_name" ]]; then
        fail_attach_usage "$command_name" "provide exactly one session target"
        return
    fi

    session_name=$(normalize_session_name "$session_name")
    initialize_state_runtime || return
    connect_session "$session_name"
}

function run_list {
    local output=""
    local selection=""
    local index=0
    local selected_row=""
    local selected_name=""
    local -a rows=()

    if (( $# > 0 )); then
        fail "ls does not accept arguments"
        return
    fi
    initialize_state_runtime || return
    if ! output=$(run_tmux_command list-sessions); then
        return 1
    fi
    mapfile -t rows <<< "$output"

    for index in "${!rows[@]}"; do
        printf '%d %s\n' "$((index + 1))" "${rows[$index]}"
    done
    printf 'Select session: '
    if ! IFS= read -r selection; then
        printf '\n' >&2
        fail "no selection received"
        return
    fi
    if [[ ! "$selection" =~ ^[0-9]+$ ]]; then
        fail "selection must be a number"
        return
    fi

    while [[ "${#selection}" -gt 1 ]] && [[ "${selection:0:1}" == "0" ]]; do
        selection="${selection:1}"
    done
    selected_name=""
    for index in "${!rows[@]}"; do
        if [[ "$selection" == "$((index + 1))" ]]; then
            selected_row="${rows[$index]}"
            selected_name="${selected_row%%:*}"
            break
        fi
    done
    if [[ -z "$selected_name" ]]; then
        fail "selection is outside the displayed range"
        return
    fi
    connect_session "$selected_name"
}

function main {
    local command_name="${1:-}"

    if [[ -z "$command_name" ]]; then
        print_usage >&2
        return 2
    fi
    shift

    if [[ "$command_name" == "__state-ack" ]]; then
        if (( $# != 4 )); then
            return 2
        fi
        acknowledge_state_transaction "$1" "$2" "$3" "$4"
        return
    fi

    case "$command_name" in
        -V|--version)
            if (( $# > 0 )); then
                fail "version does not accept arguments"
                print_usage >&2
                return 2
            fi
            print_version
            return 0
            ;;
        -h|--help)
            if (( $# > 0 )); then
                fail "help does not accept arguments"
                print_usage >&2
                return 2
            fi
            print_usage
            return 0
            ;;
        create|c)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_create_help "$command_name"
                return 0
            fi
            ;;
        repo)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_repo_help
                return 0
            fi
            ;;
        recent)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_recent_help
                return 0
            fi
            ;;
        last)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_last_help
                return 0
            fi
            ;;
        ls)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_list_help
                return 0
            fi
            ;;
        attach|a)
            if (( $# == 1 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
                print_attach_help "$command_name"
                return 0
            fi
            ;;
        *)
            printf '%s: unknown command: %s\n' \
                "$PROGRAM_NAME" "$command_name" >&2
            print_usage >&2
            return 2
            ;;
    esac

    if [[ -z "$TMUX_BIN" ]] || [[ ! -x "$TMUX_BIN" ]]; then
        fail "tmux is not available in PATH"
        return
    fi
    validate_client_server || return

    case "$command_name" in
        create|c)
            run_create "$command_name" "$@"
            ;;
        repo)
            run_repo "$@"
            ;;
        recent)
            run_recent "$@"
            ;;
        last)
            run_last "$@"
            ;;
        attach|a)
            run_attach "$command_name" "$@"
            ;;
        ls)
            run_list "$@"
            ;;
    esac
}

main "$@"
